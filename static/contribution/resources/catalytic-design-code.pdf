# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 9 â€”â€” å­¦å§ç¬¬ä¸€æ‰¹å•ä½ç‚¹é¥±å’Œå®žéªŒæ•°æ® é‡æ–°åˆ†æž + è®¡ç®—é¢„æµ‹äº¤å‰éªŒè¯

æ•°æ®ï¼šACA_295(è„±é¶) / GCG_388(on-target) / GCA_871(+1=Aè„±é¶)ï¼Œæ¯ä¸ªçªå˜ 2 é‡å¤ã€‚
æŒ‡æ ‡ï¼š
  on-target ä¿ç•™çŽ‡ = GCG_mut / GCG_WT
  +1 æ¯”(ä¿GæŽ’A) = GCG_388 / GCA_871   ï¼ˆWT=1.37ï¼Œè¶Šé«˜è¶Šç‰¹å¼‚ï¼‰
äº§å‡ºï¼šresults/experimental_ranking.csvã€results/cross_validation.csv
"""
import csv
import statistics
import openpyxl

SRC = r"data\external\01a06031-d7d4-72cf-a2a5-f46d90d768dd.xlsx"
OUT = "results"

wb = openpyxl.load_workbook(SRC, data_only=True)
ws = wb["Sheet1"]
dp = wb["æµ‹åºæ·±åº¦"]

data, depth = {}, {}
for row in ws.iter_rows(values_only=True):
    if row[0] is None or row[1] is None:
        continue
    n = str(row[0]).strip()
    if n == "ACA_295":
        continue
    data.setdefault(n, []).append((row[1], row[2], row[3]))
for row in dp.iter_rows(values_only=True):
    if row[0] is None or row[1] is None:
        continue
    n = str(row[0]).strip()
    if n == "ACA_295_DP":
        continue
    depth.setdefault(n, []).append((row[1], row[2], row[3]))


def mean(xs):
    return statistics.mean(xs)


wt = next(mean([r[1] for r in reps]) for n, reps in data.items() if "WT" in n)
wt_gca = next(mean([r[2] for r in reps]) for n, reps in data.items() if "WT" in n)

rows = []
for n, reps in data.items():
    gcg = mean([r[1] for r in reps])
    gca = mean([r[2] for r in reps])
    aca = mean([r[0] for r in reps])
    ratio = gcg / gca if gca else 0
    retain = gcg / wt
    d = depth.get(n)
    mindp = min(min(x) for x in d) if d else None
    rows.append(
        dict(
            mut=n,
            GCG=round(gcg, 3),
            GCA=round(gca, 3),
            ACA=round(aca, 3),
            ratio=round(ratio, 2),
            retain=round(retain, 2),
            depth=mindp,
            active=retain >= 0.7,
        )
    )

rows.sort(key=lambda r: (-r["ratio"]))

# å…¨æŽ’åï¼ˆä¿ç•™æ´»è·ƒï¼‰ + æŽ¢é’ˆï¼ˆæ´»æ€§å´©ä½†é«˜æ¯”ï¼‰
with open(f"{OUT}/experimental_ranking.csv", "w", newline="", encoding="utf-8-sig") as f:
    w = csv.DictWriter(
        f, fieldnames=["mut", "GCG", "GCA", "ACA", "ratio", "retain", "depth", "active"]
    )
    w.writeheader()
    for r in rows:
        w.writerow(r)

# äº¤å‰éªŒè¯
CAND = [
    ("M132E", "132E"),
    ("M132D", "132D"),
    ("K30H", "30H"),
    ("K30N", "30N"),
    ("G27D", "27D"),
    ("G27T", "27T"),
    ("G27V", "27V"),
    ("G27I", "27I"),
    ("T31A", "31A"),
    ("T31C", "31C"),
    ("A59S", "59S"),
    ("K60H", "60H"),
    ("R28W", "28W"),
    ("25E", "25E"),
    ("58M", "58M"),
]
cv = []
for label, key in CAND:
    if key not in data:
        cv.append(dict(cand=label, exp="æœªæµ‹è¯•", ratio="", retain="", verdict="æœªè¦†ç›–"))
        continue
    reps = data[key]
    gcg = mean([r[1] for r in reps])
    gca = mean([r[2] for r in reps])
    ratio = gcg / gca if gca else 0
    retain = gcg / wt
    verdict = (
        "âœ“è¯å®ž"
        if (ratio > wt / wt_gca and retain >= 0.7)
        else ("âœ—è¯ä¼ª/æ— æ”¹å–„" if ratio <= wt / wt_gca else "æ´»æ€§åä½Ž(æŽ¢é’ˆ)")
    )
    cv.append(
        dict(
            cand=label,
            exp=key,
            ratio=round(ratio, 2),
            retain=f"{retain:.0%}",
            verdict=verdict,
        )
    )

with open(f"{OUT}/cross_validation.csv", "w", newline="", encoding="utf-8-sig") as f:
    w = csv.DictWriter(f, fieldnames=["cand", "exp", "ratio", "retain", "verdict"])
    w.writeheader()
    w.writerows(cv)

print(f"WT åŸºçº¿: GCG={wt:.3f} GCA={wt_gca:.3f}  +1æ¯”={wt/wt_gca:.2f}")
print(f"\n=== æ´»è·ƒ(ä¿ç•™â‰¥70%)çªå˜æŒ‰ +1æ¯” æŽ’åº å‰ 15 ===")
for r in [x for x in rows if x["active"]][:15]:
    print(
        f"  {r['mut']:<8} GCG={r['GCG']:.3f} GCA={r['GCA']:.3f} ACA={r['ACA']:.3f} "
        f"+1æ¯”={r['ratio']:.2f} ä¿ç•™={r['retain']:.0%}"
    )
print(f"\n=== è®¡ç®—å€™é€‰ äº¤å‰éªŒè¯ ===")
for r in cv:
    print(
        f"  {r['cand']:<8} å®žéªŒ{r['exp']:<5} +1æ¯”={r['ratio']:<5} ä¿ç•™={r['retain']:<5} {r['verdict']}"
    )
print(f"\nå†™å…¥ {OUT}/experimental_ranking.csv, {OUT}/cross_validation.csv")

endstream
