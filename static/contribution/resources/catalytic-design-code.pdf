        "CP_GCA",
        "Î”CP_çªå˜ä½“",
        "Î”CP_WT",
        "Î”Î”CP",
        "|Î”Î”CP|â‰¥0.05",
    ]
)
nch = 0
for k, m in enumerate(MUTS):
    for i in range(1, N + 1):
        g, a = WTCP.get(m, {}).get(i, (None, None))
        if g is None:  # batch2 æ—  wt_cpG/wt_cpA åˆ—ï¼Œç”¨ dcp åæŽ¨ï¼š
            g, a = "", ""  # CP_GCG/CP_GCA ç•™ç©ºï¼ˆbatch2 æœªå¯¼å‡ºåˆ†é¡¹ï¼‰
        dd = D[k, i - 1]
        flag = "æ˜¯" if abs(dd) >= 0.05 else ""
        if flag:
            nch += 1
        ws3.append(
            [NAME.get(m, m), i, AA[i], g, a, fm(DCP[m][i]), fm(WT[i - 1]), fm(dd), flag]
        )
style_header(ws3, 9, [16, 7, 7, 10, 10, 13, 11, 11, 15])
ws3.auto_filter.ref = f"A1:I{ws3.max_row}"
print(f"é•¿æ ¼å¼è¡Œæ•° {ws3.max_row - 1}ï¼Œå…¶ä¸­ |Î”Î”CP|â‰¥0.05 çš„ {nch} è¡Œ")

# --- Sheet4 WT é‡å¤æ€§å‚è€ƒ ---
ws4 = wb.create_sheet("4_WTé‡å¤æ€§å‚è€ƒ")
b2wt = [float(r["dcp"]) for r in b2 if r["mut"] == "wt"]
ws4.append(
    ["æ®‹åŸº", "WT_aa", "Î”CP_åŸºçº¿(AF3æ‰¹1)", "Î”CP_WTç‹¬ç«‹é‡è·‘(AF3æ‰¹2)", "å·®å€¼(=AF3è‡ªèº«å™ªå£°)"]
)
for i in range(1, N + 1):
