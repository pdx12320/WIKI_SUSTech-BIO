    t10 = f"{e['top10']:.2f}" if np.isfinite(e['top10']) else "â€”"
    p5 = f"{e['top5_p']:.3f}" if np.isfinite(e['top5_p']) else "â€”"
    p10 = f"{e['top10_p']:.3f}" if np.isfinite(e['top10_p']) else "â€”"
    print(
        f"{e['method']:<16}{e['outcome']:<16}{e['n']:>4}{e['pearson']:>+9.3f}"
        f"{e['spearman']:>+10.3f}{t5:>8}{p5:>8}{t10:>8}{p10:>8}"
    )

with open("results/æ–¹æ³•é‡è¯„ä»·_topN.csv", "w", newline="", encoding="utf-8-sig") as f:
    w = csv.writer(f)
