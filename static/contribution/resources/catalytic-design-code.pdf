ws5.append(["ï¼ˆWT åŸºçº¿ï¼‰", N, 0, 0, 0, fm(WT.mean(), 4), fm(WT.mean(), 4), "", ""])
style_header(ws5, 9, [16, 8, 20, 15, 12, 17, 15, 11, 11])
ws5.auto_filter.ref = f"A1:I{ws5.max_row}"

wb.save("results/çªå˜ä½“åŸºçº¿Î”CP_å…¨199æ®‹åŸº.xlsx")
print("å†™å…¥ results/çªå˜ä½“åŸºçº¿Î”CP_å…¨199æ®‹åŸº.xlsx")

# ---------- æŽ§åˆ¶å°æ ¸å¯¹ ----------
