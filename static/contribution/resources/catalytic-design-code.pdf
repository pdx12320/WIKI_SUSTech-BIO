).font = Font(italic=True, size=9)

# --- Sheet2 Î”Î”CP çŸ©é˜µ ---
ws2 = wb.create_sheet("2_Î”Î”CPçŸ©é˜µ")
ws2.append(["æ®‹åŸº", "WT", "åŒºåŸŸ"] + [NAME.get(m, m) for m in MUTS])
for i in range(1, N + 1):
