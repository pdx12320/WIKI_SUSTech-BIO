# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 51 â€”â€” ç”¨ top-5 / top-10 å›žæ”¶çŽ‡é‡æ–°è¯„ä»·æ­¤å‰æ‰€æœ‰æ–¹æ³•

èƒŒæ™¯ï¼ˆPeng et al. 2026 Mol Cell çš„å¯ç¤ºï¼‰ï¼š
  æ­¤å‰ä¸€å¾‹ç”¨ Pearson / Spearman è¯„ä»·é¢„æµ‹æ–¹æ³•ï¼Œç»“è®ºæ˜¯ã€Œå…¨éƒ¨å¤±è´¥ã€ã€‚
  ä½†çœŸæ­£å†³å®šå®žç”¨ä»·å€¼çš„æ˜¯ã€Œèƒ½ä¸èƒ½æŠŠæœ€å¥½çš„å‡ ä¸ªæŽ’è¿›å‰å‡ åã€â€”â€”å³ top-N å›žæ”¶çŽ‡ã€‚
  æœ¬è„šæœ¬å¯¹æ¯ä¸ªæ–¹æ³•åŒæ—¶ç»™å‡ºï¼šPearsonã€Spearmanã€NDCG@10ã€top-5 å›žæ”¶ã€top-10 å›žæ”¶ï¼Œ
  å¹¶ç”¨ç½®æ¢æ£€éªŒç»™å‡º top-N å›žæ”¶çŽ‡çš„ç»éªŒ p å€¼ï¼ˆå°æ ·æœ¬ä¸‹ top-N çš„æ–¹å·®å¾ˆå¤§ï¼Œå¿…é¡»åšæ£€éªŒï¼‰ã€‚

è¢«è¯„ä»·çš„æ–¹æ³•ï¼š
  mCSM-NA      results/mcsm_single_rerank.csv        ï¼ˆscore = combinedï¼‰
  PremPRI      results/prempri_single_rerank.csv     ï¼ˆscore = scoreï¼‰
  Î”d_E72       results/dE72_regression.csv           ï¼ˆscore = delta_d_E72ï¼Œå‡è®¾è¶Šå¤§è¶Šå¥½ï¼‰
  åŠ æ€§å…ˆéªŒæ¨¡åž‹  results/23_pair_score_matrix.csv       ï¼ˆscore = theoryï¼‰
  CP / Î”CP     results/mut_cp_summary_ä¿GæŽ’A.csv      ï¼ˆscore = æŽ’AæŒ‡æ•° âˆ’ ä¿GæŒ‡æ•°ï¼‰

äº§å‡ºï¼šresults/æ–¹æ³•é‡è¯„ä»·_topN.csv
"""
import csv, sys, math, re, json

sys.stdout.reconfigure(encoding="utf-8")
import numpy as np


# ---------------------------------------------------------------------------
# æŒ‡æ ‡
# ---------------------------------------------------------------------------
def pearson(x, y):
    x = np.asarray(x, float)
    y = np.asarray(y, float)
    x = x - x.mean()
    y = y - y.mean()
    d = math.sqrt((x**2).sum() * (y**2).sum())
    return float((x * y).sum() / d) if d > 0 else float("nan")


def spearman(x, y):
    def rk(v):
        s = np.argsort(np.asarray(v, float))
        r = np.empty(len(v))
        r[s] = np.arange(len(v))
        return r

    return pearson(rk(x), rk(y))


def ndcg_at(y_true, y_pred, k):
    yt = np.asarray(y_true, float)
    if np.ptp(yt) <= 0:
        return float("nan")
    yt = (yt - yt.min()) / np.ptp(yt)
    k = min(k, len(yt))
    order = np.argsort(-np.asarray(y_pred, float))[:k]
    ideal = np.argsort(-yt)[:k]
    disc = 1.0 / np.log2(np.arange(2, k + 2))
    idcg = float((yt[ideal] * disc).sum())
    return float((yt[order] * disc).sum()) / idcg if idcg > 0 else float("nan")


def topn_recovery(y_true, y_pred, n):
    yt = np.asarray(y_true, float)
    n = min(n, len(yt))
    a = set(np.argsort(-np.asarray(y_pred, float))[:n])
    b = set(np.argsort(-yt)[:n])
    return len(a & b) / n


def exact_topn_p(n, k, m):
    """ç²¾ç¡®è¶…å‡ ä½• p å€¼ï¼šä»Ž n ä¸ªé‡ŒéšæœºæŒ‘ k ä¸ªï¼Œä¸ŽçœŸå®ž top-k çš„é‡å  >= m çš„æ¦‚çŽ‡ã€‚"""
    from math import comb

    if k > n:
        return float("nan")
    tot = comb(n, k)
    p = sum(
        comb(k, j) * comb(n - k, k - j) for j in range(m, k + 1) if 0 <= k - j <= n - k
    )
    return p / tot


def evaluate(score, outcome, n_perm=5000, seed=0):
    """è¿”å›žæŒ‡æ ‡å­—å…¸ã€‚top-N å›žæ”¶çŽ‡ç”¨ç²¾ç¡®è¶…å‡ ä½• p å€¼ï¼ˆç½®æ¢åªèƒ½ç»™è¿‘ä¼¼ï¼Œä¸”å°æ ·æœ¬ä¸‹ä¸ç¨³ï¼‰ã€‚
    æŠ¤æ ï¼šn < 10 ä¸æŠ¥ top-5ï¼ˆç»„åˆæ•°å¤ªå°‘ï¼Œæ— åŒºåˆ†åŠ›ï¼‰ï¼›n < 15 ä¸æŠ¥ top-10ã€‚"""
    s = np.asarray(score, float)
    o = np.asarray(outcome, float)
    m = np.isfinite(s) & np.isfinite(o)
    s, o = s[m], o[m]
    n = len(s)
    if n < 6:
        return None
    out = dict(
        n=n,
        pearson=pearson(s, o),
        spearman=spearman(s, o),
        ndcg10=ndcg_at(o, s, 10) if n >= 15 else float("nan"),
        top5=float("nan"),
        top5_p=float("nan"),
        top5_note="",
        top10=float("nan"),
        top10_p=float("nan"),
        top10_note="",
    )
    if n >= 10:
        m5 = int(round(topn_recovery(o, s, 5) * 5))
        out.update(top5=m5 / 5, top5_p=exact_topn_p(n, 5, m5))
    else:
        out["top5_note"] = f"n={n}<10ï¼Œç»„åˆæ•°ä»… {comb_n(n,5)} ç§ï¼Œæ— åŒºåˆ†åŠ›"
    if n >= 15:
        m10 = int(round(topn_recovery(o, s, 10) * 10))
        out.update(top10=m10 / 10, top10_p=exact_topn_p(n, 10, m10))
    else:
        out["top10_note"] = f"n={n}<15ï¼Œä¸æŠ¥ top-10"
    return out


def comb_n(n, k):
    from math import comb

    return comb(n, k) if k <= n else 0


# ---------------------------------------------------------------------------
# å®žæµ‹ç»“æžœ
# ---------------------------------------------------------------------------
single = {}
for r in csv.DictReader(open("results/experimental_ranking.csv", encoding="utf-8-sig")):
    try:
        single[r["mut"]] = dict(
            ratio=float(r["ratio"]),
            retain=float(r["retain"]),
            active=r["active"] == "True",
        )
    except ValueError:
        pass
combo = {}
for r in csv.DictReader(open("results/GCG_vs_off_ranking_WT.csv", encoding="utf-8-sig")):
    try:
        tr = float(r["targeting_ratio"])
    except Exception:
        continue
    combo[r["mutation"]] = dict(
        tr=tr, act=float(r["activity_retention"] or 0), finite=not math.isinf(tr)
    )
print(f"å®žæµ‹å•ç‚¹ {len(single)} ä¸ªï¼›å®žæµ‹ç»„åˆ {len(combo)} ä¸ª")


def wet_key(name):
    """M132D -> 132D ; G25E -> 25E ; 27T-30H -> 27T-30H ; g27tk30hq58m -> 27T-30H-58M"""
    if not name:
        return None
    s = str(name)
    if s.upper().startswith("WT") or "PUF12-9" in s:
        return None
    if (
        "-" in s
        and re.match(r"^\d", s)
        and len(s.split("-")) > 1
        and not re.match(r"^[A-Z]\d+[A-Z]$", s.split("-")[0])
    ):
        return s  # å·²æ˜¯ 27T-30H å½¢å¼
    if re.match(r"^[A-Z]\d+[A-Z]$", s):
        m = re.match(r"^([A-Z])(\d+)([A-Z])$", s)
        return f"{m.group(2)}{m.group(3)}"
    # å°å†™è¿žå†™å½¢å¼ g27tk30hq58m
    parts = re.findall(r"([a-z])(\d+)([a-z])", s.lower())
    if parts:
        return (
            "-".join(f"{p}{a.upper()}" for _, p, a in parts).replace("-", "-")
            if False
            else "-".join(f"{int(p)}{a.upper()}" for _, p, a in parts)
        )
    return None


def combo_key(name):
    """æŠŠå„ç§ç»„åˆå†™æ³•ç»Ÿä¸€æˆ 27T-30H-58M å½¢å¼ã€‚"""
    if not name:
        return None
    s = str(name).strip()
    if s.upper().startswith("WT") or "PUF12-9" in s:
        return None
    parts = re.split(r"[+\-]", s)
    out = []
    for p in parts:
        p = p.strip()
        m = re.match(r"^([A-Z])(\d+)([A-Z])$", p)
        if m:
            out.append(f"{m.group(2)}{m.group(3)}")
            continue
        m = re.match(r"^(\d+)([A-Z])$", p)
        if m:
            out.append(f"{m.group(1)}{m.group(2)}")
    return "-".join(out) if out else None


# ---------------------------------------------------------------------------
# é€æ–¹æ³•è¯„ä»·
# ---------------------------------------------------------------------------
RES = []


def record(
    method, scope, score_name, score, names, keyfn, outcome_name, outcome_map, getter
):
    pts = []
    for nm, sc in zip(names, score):
        k = keyfn(nm)
        if k is None or k not in outcome_map:
            continue
        v = getter(outcome_map[k])
        if v is None:
            continue
        pts.append((float(sc), float(v)))
    if len(pts) < 6:
        print(f"  [è·³è¿‡] {method} / {outcome_name}ï¼šå¯æ¯”æ ·æœ¬ä»… {len(pts)} ä¸ª")
        return
    s, o = zip(*pts)
    e = evaluate(s, o)
    e.update(
        method=method,
        scope=scope,
        score=score_name,
        outcome=outcome_name,
        matched=len(pts),
    )
    RES.append(e)

    def fmt(v, p):
        if not np.isfinite(v):
            return "   â€”    "
        return (
            f"{v:.2f}" + ("â˜…" if np.isfinite(p) and p <= 0.05 else " ") + f"(p={p:.3f})"
        )

    print(
        f"  {method:<14}{outcome_name:<14}n={e['n']:<3} "
        f"r={e['pearson']:+.3f} Ï={e['spearman']:+.3f}  "
        f"top5={fmt(e['top5'], e['top5_p']):<14}top10={fmt(e['top10'], e['top10_p'])}"
    )


