# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 15 â€”â€” ContactSeek å¼ CP + Î”CP åˆ†æžï¼ˆæ›¿ä»£è·ç¦»æŽ¥è§¦åˆ†æžï¼‰

æ–¹æ³•ï¼ˆå€Ÿé‰´ ContactSeek, Nature 2026ï¼‰ï¼š
  - ä»Ž AF3 è¾“å‡ºçš„ full_data JSON é‡Œå–ã€Œcontact_probsã€çŸ©é˜µï¼ˆä¸¤æ®‹åŸºåœ¨ 8 Ã… å†…çš„æ¦‚çŽ‡ï¼‰ï¼Œ
    æ¯”ã€Œç”¨åæ ‡ç®—è·ç¦»ã€æ›´æ•æ„Ÿï¼Œèƒ½æ•æ‰è·ç¦»æ²¡å˜ä½†æŽ¥è§¦æ¦‚çŽ‡å˜åŒ–çš„å¾®å¼±å·®å¼‚ã€‚
  - å¯¹æ¯ä¸ªæ¨¡åž‹æå–ã€Œè›‹ç™½æ®‹åŸº â†” +1 æ ¸è‹·é…¸(chain B resi 5)ã€çš„ CPã€‚
  - æŒ‰ RNA åˆ†ç»„å–å¹³å‡ CPï¼›ç®— Î”CP = CP(off) âˆ’ CP(on)ï¼š
        Î”CP_swap = CP(GUGCACG) âˆ’ CP(GUGCGCG)   ï¼ˆçº¯ +1 Gâ†’A äº¤æ¢ï¼‰
        Î”CP_off  = CP(AUGCAGC) âˆ’ CP(GUGCGCG)   ï¼ˆå®Œæ•´è„±é¶ï¼‰
  - Î”CP > 0 = è¯¥æ®‹åŸºåœ¨ +1=A æ—¶æŽ¥è§¦å¢žå¼ºï¼ˆè„±é¶ç¨³å®šï¼‰â†’ æŽ’A å€™é€‰ã€‚

äº§å‡ºï¼šresults/cp_dcp.csvã€results/cp_dcp_ranking.csv
"""
import csv
import json
import os
import re
from collections import defaultdict

import af_utils as U

OUT = "results"

manifest = list(
    csv.DictReader(open(os.path.join(OUT, "manifest.csv"), encoding="utf-8-sig"))
)


def full_data_path(model_cif_path, rank):
    """ç”± model_0.cif è·¯å¾„æŽ¨å¯¼ full_data_0.json è·¯å¾„ã€‚"""
    return re.sub(rf"_model_{rank}\.cif$", f"_full_data_{rank}.json", model_cif_path)


def load_cp(model_path, rank):
    """åŠ è½½ token_chain_ids / token_res_ids / contact_probsã€‚"""
    p = full_data_path(model_path, rank)
    with open(p, encoding="utf-8") as f:
        d = json.load(f)
    return d["token_chain_ids"], d["token_res_ids"], d["contact_probs"]


def extract_cp(chain_ids, res_ids, cp, target_chain, target_res):
    """è¿”å›ž {è›‹ç™½æ®‹åŸº: CP(è¯¥æ®‹åŸº â†’ ç›®æ ‡æ ¸è‹·é…¸)}ã€‚"""
    # æ‰¾ç›®æ ‡æ ¸è‹·é…¸çš„ token ç´¢å¼•
    tgt_idx = None
    for i in range(len(chain_ids)):
        if chain_ids[i] == target_chain and res_ids[i] == target_res:
            tgt_idx = i
            break
    if tgt_idx is None:
        return {}
    out = {}
    for i in range(len(chain_ids)):
        if chain_ids[i] == U.PROT_CHAIN:
            # CP å–ä¸¤æ–¹å‘çš„æœ€å¤§å€¼ï¼ˆæ›´ç¨³å¥ï¼‰
            c = max(cp[i][tgt_idx], cp[tgt_idx][i])
            out[res_ids[i]] = c
    return out


# èšåˆï¼šrna -> resi -> [CP åˆ—è¡¨]
agg = defaultdict(lambda: defaultdict(list))
nmodel = defaultdict(int)

for m in manifest:
    rna = m["rna"]
    rank = int(m["rank"])
    try:
        chain_ids, res_ids, cp = load_cp(m["path"], rank)
    except FileNotFoundError:
        continue
    nmodel[rna] += 1
    per_res = extract_cp(chain_ids, res_ids, cp, U.RNA_CHAIN, U.PLUS1_RESI)
    for resi, c in per_res.items():
        agg[rna][resi].append(c)

# å¹³å‡ CP
mean_cp = defaultdict(dict)  # rna -> resi -> mean CP
for rna in U.RNA_SEQS:
    for resi, cs in agg[rna].items():
        mean_cp[rna][resi] = sum(cs) / len(cs)

# è®¡ç®— Î”CP
all_resi = set()
for rna in U.RNA_SEQS:
    all_resi |= set(mean_cp[rna].keys())

rows = []
for resi in sorted(all_resi):
    cg = mean_cp["GUGCGCG"].get(resi, 0.0)
    ca_swap = mean_cp["GUGCACG"].get(resi, 0.0)
    ca_off = mean_cp["AUGCAGC"].get(resi, 0.0)
    rows.append(
        dict(
            resi=resi,
            cp_G=round(cg, 4),
            cp_A_swap=round(ca_swap, 4),
            cp_A_off=round(ca_off, 4),
            dcp_swap=round(ca_swap - cg, 4),
            dcp_off=round(ca_off - cg, 4),
        )
    )

with open(f"{OUT}/cp_dcp.csv", "w", newline="", encoding="utf-8-sig") as f:
    w = csv.DictWriter(
        f, fieldnames=["resi", "cp_G", "cp_A_swap", "cp_A_off", "dcp_swap", "dcp_off"]
    )
    w.writeheader()
    w.writerows(rows)

# æŽ’åï¼šæŒ‰ Î”CPï¼ˆswapï¼Œçº¯ +1 åˆ¤åˆ«ï¼‰é™åº
ranked = sorted(rows, key=lambda r: -r["dcp_swap"])
with open(f"{OUT}/cp_dcp_ranking.csv", "w", newline="", encoding="utf-8-sig") as f:
    w = csv.DictWriter(
        f,
        fieldnames=[
            "rank",
            "resi",
            "cp_G",
            "cp_A_swap",
            "cp_A_off",
            "dcp_swap",
            "dcp_off",
        ],
    )
    w.writeheader()
    for i, r in enumerate(ranked, 1):
        w.writerow(dict(rank=i, **r))

# æ‰“å°å…³é”®æ®‹åŸº + å‰ 20
KEYS = [27, 28, 29, 30, 31, 32, 57, 58, 59, 60, 70, 72, 98, 99, 102, 105, 130, 132]
print(f"== å…³é”®æ®‹åŸºçš„ CP / Î”CPï¼ˆ+1 æ ¸è‹·é…¸ï¼‰==")
print(
    f"{'resi':>4} {'CP(G)':>7} {'CP(A_swap)':>10} {'CP(A_off)':>9} {'Î”CP_swap':>9} {'Î”CP_off':>8}"
)
for resi in KEYS:
    r = next((x for x in rows if x["resi"] == resi), None)
    if r:
        print(
            f"{resi:>4} {r['cp_G']:>7} {r['cp_A_swap']:>10} {r['cp_A_off']:>9} "
            f"{r['dcp_swap']:>+9} {r['dcp_off']:>+8}"
        )

print(f"\n== Î”CP_swap å‰ 20ï¼ˆ+1=Gâ†’A æ—¶æŽ¥è§¦å¢žå¼ºæœ€å¤šçš„æ®‹åŸº = æŽ’Aå€™é€‰ï¼‰==")
print(f"{'resi':>4} {'CP(G)':>7} {'CP(A)':>7} {'Î”CP':>8}")
for r in ranked[:20]:
    print(f"{r['resi']:>4} {r['cp_G']:>7} {r['cp_A_swap']:>7} {r['dcp_swap']:>+8}")

print(f"\nå†™å…¥ {OUT}/cp_dcp.csv, {OUT}/cp_dcp_ranking.csv")

endstream
