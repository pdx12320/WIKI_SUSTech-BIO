# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 30 â€”â€” é¶ç‚¹(GCG)ç¼–è¾‘æ€»å’Œ vs è„±é¶ç¼–è¾‘æ€»å’Œ æŽ’åºä¸Žç»˜å›¾ï¼ˆP éƒ¨åˆ†ä»…ä¿ç•™ WTï¼‰

æ ·æœ¬èŒƒå›´å˜æ›´ï¼ˆç›¸å¯¹é˜¶æ®µ 29ï¼‰ï¼š
  å‰”é™¤ï¼šP4-SNEã€P5-TWDã€P6-WFDã€P7-THEã€P7-SNEã€P8-GVDï¼ˆP ç³»åˆ— loop é‡è®¾è®¡å˜ä½“ï¼‰
  ä¿ç•™ï¼šPUF12-9 â€”â€” å³ WT / ç»„åˆäº²æœ¬ï¼Œä½œä¸ºæ­£å¸¸ä¸€è¡Œå‚ä¸ŽæŽ’åºï¼ˆå›¾ä¸­ä»¥æ˜Ÿæ ‡ä¸Žç»¿è‰²çªå‡ºï¼‰

å£å¾„ï¼ˆä¸Žé˜¶æ®µ 29 ä¸€è‡´ï¼‰ï¼š
  é¶ç‚¹ = å…¨éƒ¨ 47 ä¸ª GCG ä½ç‚¹  â†’ Î£_gcg
  è„±é¶ = å…¶ä½™ 244 ä¸ª C ä½ç‚¹    â†’ Î£_off
  é¶å‘æ¯” = Î£_gcg / Î£_off      â†’ æŽ’åºä¾æ®
  æ´»æ€§   = C388 / C388(WT=PUF12-9)

äº§å‡ºï¼šresults/GCG_vs_off_ranking_WT.csv
      results/GCG_vs_off_ranking_WT.png
"""
import glob, os, re, sys, csv, statistics
from collections import defaultdict

sys.stdout.reconfigure(encoding="utf-8")

REF = "".join(
    l
    for l in open("Seq/Bam/G22609034389-1-32F.for.ref.fa", encoding="utf-8")
    .read()
    .splitlines()
    if not l.startswith(">")
)
L = len(REF)
FLOOR = 0.05
CS = [i + 1 for i, c in enumerate(REF) if c == "C"]


def motif(p):
    i = p - 1
    return "?" if (i - 1 < 0 or i + 1 >= L) else REF[i - 1] + "C" + REF[i + 1]


GCG = [p for p in CS if motif(p) == "GCG"]
NON = [p for p in CS if motif(p) != "GCG"]
WT_NAME = "PUF12-9"
EXCLUDE_PS = {"P4-SNE", "P5-TWD", "P6-WFD", "P7-THE", "P7-SNE", "P8-GVD"}


def parse(p):
    out = {}
    for i, l in enumerate(open(p, encoding="latin-1")):
        if i == 0:
            continue
        c = l.rstrip("\n").split("\t")
        if len(c) < 11 or c[2] != "C" or c[3] != "T":
            continue
        try:
            pos, freq = int(c[1]), float(c[7])
        except ValueError:
            continue
        if freq >= FLOOR:
            out[pos] = freq
    return out


def mut_of(n):
    m = re.match(r'G\d+-(b?)(\d+)-(.*)$', n)
    return m.group(3) if m else n


by_mut = defaultdict(list)
for f in sorted(glob.glob("Seq/Var/*.var.xls")):
    if ".filt." in f:
        continue
    n = os.path.basename(f).replace(".var.xls", "")
    by_mut[mut_of(n)].append(parse(f))

PAR_C388 = statistics.mean([st.get(388, 0) for st in by_mut[WT_NAME]])
print(f"WT(PUF12-9) çš„ C388 = {PAR_C388:.4f}  â†’ æ´»æ€§ = C388 / {PAR_C388:.5f}")
print(f"å‰”é™¤çš„ P ç³»åˆ—: {', '.join(sorted(EXCLUDE_PS))}ï¼›ä¿ç•™ WT: {WT_NAME}\n")

rows = []
for mut, ss in by_mut.items():
    if mut in EXCLUDE_PS:
        continue
    sg = statistics.mean([sum(st.get(p, 0.0) for p in GCG) for st in ss])
    so = statistics.mean([sum(st.get(p, 0.0) for p in NON) for st in ss])
    n_g = statistics.mean([sum(1 for p in GCG if p in st) for st in ss])
    n_o = statistics.mean([sum(1 for p in NON if p in st) for st in ss])
    c388 = statistics.mean([st.get(388, 0) for st in ss])
    rows.append(
        dict(
            mut=mut,
            sum_gcg=sg,
            sum_off=so,
            ratio=(sg / so) if so > 0 else float("inf"),
            n_gcg=n_g,
            n_off=n_o,
            c388=c388,
            act=c388 / PAR_C388,
            is_wt=(mut == WT_NAME),
        )
    )

main = sorted(rows, key=lambda r: -r["ratio"])

print("=" * 122)
print("è¡¨  é¶ç‚¹(GCG)ç¼–è¾‘æ€»å’Œ / è„±é¶ç¼–è¾‘æ€»å’Œ æŽ’åºï¼ˆP éƒ¨åˆ†ä»…ä¿ç•™ WTï¼›æŒ‰é¶å‘æ¯”é™åºï¼‰")
print("=" * 122)
print(
    f"{'æŽ’å':>4}{'çªå˜':<20}{'Î£_GCG(é¶ç‚¹)':>12}{'Î£_off(è„±é¶)':>12}{'é¶å‘æ¯”':>9}"
    f"{'æ´»æ€§(ä¿ç•™)':>11}{'C388':>8}{'GCGä½ç‚¹æ•°':>10}"
)
rk = 0
for r in main:
    if r["sum_gcg"] <= 0.01:
        continue
    rk += 1
    tag = "  â† WT åŸºçº¿" if r["is_wt"] else ""
    print(
        f"{rk:>4}{r['mut']:<20}{r['sum_gcg']*100:>12.0f}{r['sum_off']*100:>12.0f}"
        f"{r['ratio']:>9.2f}{r['act']*100:>10.0f}%{r['c388']*100:>8.0f}{r['n_gcg']:>10.1f}{tag}"
    )

print()
print("=== è”åˆåˆ¤æ®ï¼šæ´»æ€§ â‰¥70% çš„å€™é€‰ï¼ˆæŒ‰é¶å‘æ¯”é™åºï¼‰===")
print(f"{'çªå˜':<20}{'é¶å‘æ¯”':>9}{'æ´»æ€§':>8}{'Î£_GCG':>9}{'Î£_off':>8}")
for r in sorted(
    [x for x in main if x["act"] >= 0.70 and x["sum_gcg"] > 0.01],
    key=lambda x: -x["ratio"],
):
    print(
        f"{r['mut']:<20}{r['ratio']:>9.2f}{r['act']*100:>7.0f}%{r['sum_gcg']*100:>9.0f}{r['sum_off']*100:>8.0f}"
    )

with open(
    "results/GCG_vs_off_ranking_WT.csv", "w", newline="", encoding="utf-8-sig"
) as f:
    w = csv.writer(f)
    w.writerow(
        [
            "rank",
            "mutation",
            "is_WT",
            "sum_GCG_pct",
            "sum_nonGCG_pct",
            "targeting_ratio",
            "activity_retention",
            "C388_pct",
            "n_GCG_detected",
            "n_nonGCG_detected",
        ]
    )
    rk = 0
    for r in main:
        if r["sum_gcg"] > 0.01:
            rk += 1
        w.writerow(
            [
                rk if r["sum_gcg"] > 0.01 else "",
                r["mut"],
                r["is_wt"],
                f"{r['sum_gcg']*100:.1f}",
                f"{r['sum_off']*100:.1f}",
                f"{r['ratio']:.3f}",
                f"{r['act']:.3f}",
                f"{r['c388']*100:.2f}",
                f"{r['n_gcg']:.1f}",
                f"{r['n_off']:.1f}",
            ]
        )
print("\nå†™å…¥ results/GCG_vs_off_ranking_WT.csv")

# ---------------- ç»˜å›¾ ----------------
try:
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    import numpy as np

    plt.rcParams["font.sans-serif"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
    plt.rcParams["axes.unicode_minus"] = False

    plot_rows = [r for r in main if r["sum_gcg"] > 0.01][::-1]
    names = [r["mut"] + ("  â˜…WT" if r["is_wt"] else "") for r in plot_rows]
    sg = np.array([r["sum_gcg"] * 100 for r in plot_rows])
    so = np.array([r["sum_off"] * 100 for r in plot_rows])
    act = np.array([r["act"] for r in plot_rows])
    is_wt = np.array([r["is_wt"] for r in plot_rows])

    fig = plt.figure(figsize=(19, 13.5), dpi=150)
    gs = fig.add_gridspec(1, 2, width_ratios=[1.25, 1], wspace=0.30)

    # é¢æ¿Aï¼šæˆå¯¹æŸ±ï¼ŒWT ç”¨ç»¿è‰²é«˜äº®
    ax = fig.add_subplot(gs[0, 0])
    y = np.arange(len(names))
    h = 0.38
    cols_g = ["#1E7A46" if w else "#2E548B" for w in is_wt]
    cols_o = ["#7DCEA0" if w else "#C0392B" for w in is_wt]
    ax.barh(y + h / 2, sg, height=h, color=cols_g, label="é¶ç‚¹ GCG ç¼–è¾‘æ€»å’Œ Î£_gcg")
    ax.barh(y - h / 2, so, height=h, color=cols_o, label="è„±é¶(å…¶ä»– C)ç¼–è¾‘æ€»å’Œ Î£_off")
    for i, r in enumerate(plot_rows):
        lab = f"æ¯” {r['ratio']:.1f}  æ´»æ€§ {r['act']*100:.0f}%" + (
            "  â˜…WTåŸºçº¿" if r["is_wt"] else ""
        )
        ax.text(
            max(sg[i], so[i]) + 12,
            i,
            lab,
            va="center",
            fontsize=7.5,
            color="#1E7A46" if r["is_wt"] else "#333333",
            fontweight="bold" if r["is_wt"] else "normal",
        )
    ax.set_yticks(y)
    ax.set_yticklabels(names, fontsize=8)
    for tick, w in zip(ax.get_yticklabels(), is_wt):
        if w:
            tick.set_color("#1E7A46")
            tick.set_fontweight("bold")
    ax.set_xlabel("ç¼–è¾‘é¢‘çŽ‡æ€»å’Œ %ï¼ˆ47 ä¸ª GCG é¶ç‚¹ / 244 ä¸ªéž GCG ä½ç‚¹ï¼‰", fontsize=11)
    ax.set_title(
        "å„çªå˜ä½“çš„é¶ç‚¹ç¼–è¾‘æ€»å’Œ vs è„±é¶ç¼–è¾‘æ€»å’Œ\n"
        "ï¼ˆè‡ªä¸‹è€Œä¸Š = é¶å‘æ¯” Î£_gcg/Î£_off ç”±ä½Žåˆ°é«˜ï¼›P éƒ¨åˆ†ä»…ä¿ç•™ WTï¼‰",
        fontsize=12,
    )
    ax.legend(loc="lower right", fontsize=9)
    ax.grid(alpha=0.25, axis="x")

    # é¢æ¿Bï¼šæ•£ç‚¹
    ax2 = fig.add_subplot(gs[0, 1])
    nw = ~is_wt
    sc = ax2.scatter(
        so[nw],
        sg[nw],
        c=act[nw] * 100,
        cmap="RdYlGn",
        s=70,
        vmin=0,
        vmax=90,
        edgecolors="#333333",
        linewidths=0.6,
        zorder=3,
    )
    ax2.scatter(
        so[is_wt],
        sg[is_wt],
        marker="*",
        s=420,
        c="#1E7A46",
        edgecolors="white",
        linewidths=1.2,
        zorder=5,
        label="WT (PUF12-9)",
    )
    lim = max(so.max(), sg.max()) * 1.12
    ax2.plot([0, lim], [0, lim], "--", c="#7F8C8D", lw=1.2)
    ax2.text(
        lim * 0.63, lim * 0.70, "Î£_gcg = Î£_off", fontsize=8, color="#7F8C8D", rotation=32
    )
    for r in plot_rows:
        if r["ratio"] > 3 or r["act"] > 0.7 or r["sum_off"] > 300 or r["is_wt"]:
            ax2.annotate(
                r["mut"] + ("(WT)" if r["is_wt"] else ""),
                (r["sum_off"] * 100, r["sum_gcg"] * 100),
                textcoords="offset points",
                xytext=(6, 4),
                fontsize=7.5,
                color="#1E7A46" if r["is_wt"] else "#333333",
                fontweight="bold" if r["is_wt"] else "normal",
            )
    cb = fig.colorbar(sc, ax=ax2, fraction=0.04, pad=0.02)
    cb.set_label("æ´»æ€§ï¼ˆç›¸å¯¹ WT çš„ C388 ä¿ç•™ %ï¼‰", fontsize=10)
    ax2.set_xlabel("è„±é¶ç¼–è¾‘æ€»å’Œ Î£_off %", fontsize=11)
    ax2.set_ylabel("é¶ç‚¹ GCG ç¼–è¾‘æ€»å’Œ Î£_gcg %", fontsize=11)
    ax2.set_title(
        "é¶ç‚¹ vs è„±é¶ ç¼–è¾‘æ€»å’Œ\nï¼ˆå·¦ä¸Šè§’ = é«˜é¶å‘ç¼–è¾‘ + ä½Žè„±é¶ï¼›é¢œè‰² = æ´»æ€§ï¼‰",
        fontsize=12,
    )
    ax2.legend(loc="lower right", fontsize=9)
    ax2.grid(alpha=0.25)

    fig.suptitle(
