# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 2 â€”â€” +1 ä½æŽ¥è§¦åˆ†æžï¼ˆåŒå£å¾„ï¼‰

å¯¹æ¯ä¸ªé€šè¿‡è´¨æŽ§çš„æ¨¡åž‹ï¼š
  - æå– +1 ä½ï¼ˆchain B resi 5ï¼‰çš„ã€Œç¢±åŸºé‡åŽŸå­ã€ä¸Žã€Œæ•´æ ¸è‹·é…¸é‡åŽŸå­ã€ä¸¤å¥—åŽŸå­ï¼›
  - è®¡ç®—æ¯ä¸ªè›‹ç™½æ®‹åŸºï¼ˆchain Aï¼‰åˆ°è¿™ä¸¤å¥—åŽŸå­çš„æœ€å°é‡åŽŸå­è·ç¦»ï¼›
  - æŒ‰ 3.5 / 4.0 / 5.0 Ã… ä¸‰æ¡£åˆ¤å®šæ˜¯å¦æŽ¥è§¦ã€‚

äº§å‡ºï¼š
  results/contacts_long.csv   â€”â€” æ¯æ¨¡åž‹ Ã— 199 è›‹ç™½æ®‹åŸº çš„å®Œæ•´è·ç¦»è¡¨
  results/key_distances.csv   â€”â€” å…³é”®æ®‹åŸºå­é›†ï¼ˆä¾¿äºŽ G/A å¯¹æ¯”ï¼‰

ä¾èµ– results/manifest.csv ä¸Ž results/qc_report.csvï¼ˆå…ˆè·‘ 00ã€01ï¼‰ã€‚
"""
import os
import csv

import af_utils as U

OUT_DIR = "results"
os.makedirs(OUT_DIR, exist_ok=True)


def coord_list(atoms):
    return [U.coord(a) for a in atoms]


def min_dist_to_coords(atom_coords, ligand_coords):
    """åŽŸå­åæ ‡åˆ—è¡¨ -> é…ä½“åæ ‡åˆ—è¡¨ çš„æœ€å°è·ç¦»ã€‚"""
    if not atom_coords or not ligand_coords:
        return None
    best = None
    for xa, ya, za in atom_coords:
        for xb, yb, zb in ligand_coords:
            dx, dy, dz = xa - xb, ya - yb, za - zb
            d = dx * dx + dy * dy + dz * dz
            if best is None or d < best:
                best = d
    return best**0.5


# è¯»å– manifest ä¸Ž qcï¼ˆè·³è¿‡ç¡¬å‰”é™¤æ¨¡åž‹ï¼‰
manifest = []
with open(os.path.join(OUT_DIR, "manifest.csv"), encoding="utf-8-sig") as f:
    for row in csv.DictReader(f):
        manifest.append(row)

skip = set()
with open(os.path.join(OUT_DIR, "qc_report.csv"), encoding="utf-8-sig") as f:
    for row in csv.DictReader(f):
        if row["qc_pass"] == "False":
            skip.add((row["rna"], row["seed"], int(row["rank"])))

long_rows = []
key_rows = []

for row in manifest:
    rna, seed = row["rna"], row["seed"]
    rank = int(row["rank"])
    path = row["path"]
    if (rna, seed, rank) in skip:
        continue

    cols, atoms = U.parse_atom_site(path)
    plus1_all = U.atoms_of(atoms, U.RNA_CHAIN, U.PLUS1_RESI)
    plus1_base = [a for a in plus1_all if a["atom_site.label_atom_id"] in U.BASE_ATOMS]

    base_coords = coord_list(plus1_base)
    full_coords = coord_list(plus1_all)

    rA = U.residues_by_chain(atoms, U.PROT_CHAIN)
    for resi in sorted(rA):
        res_atoms = rA[resi]
        resn = res_atoms[0]["atom_site.label_comp_id"]
        rc = coord_list(res_atoms)

        d_base = min_dist_to_coords(rc, base_coords)
        d_full = min_dist_to_coords(rc, full_coords)

        rec = {
            "rna": rna,
            "seed": seed,
            "rank": rank,
            "resi": resi,
            "resn": resn,
            "min_dist_base": ("" if d_base is None else round(d_base, 3)),
            "min_dist_full": ("" if d_full is None else round(d_full, 3)),
        }
        for c in U.CUTOFFS:
            rec[f"contact_base_{c}"] = d_base is not None and d_base <= c
            rec[f"contact_full_{c}"] = d_full is not None and d_full <= c
        long_rows.append(rec)

        if resi in U.KEY_RESIDUES:
            key_rows.append(rec)

# å†™ contacts_long.csv
long_fields = [
    "rna",
    "seed",
    "rank",
    "resi",
    "resn",
    "min_dist_base",
    "min_dist_full",
    "contact_base_3.5",
    "contact_base_4.0",
    "contact_base_5.0",
    "contact_full_3.5",
    "contact_full_4.0",
    "contact_full_5.0",
]
with open(
    os.path.join(OUT_DIR, "contacts_long.csv"), "w", newline="", encoding="utf-8-sig"
) as f:
    w = csv.DictWriter(f, fieldnames=long_fields)
    w.writeheader()
    w.writerows(long_rows)

# å†™ key_distances.csvï¼ˆæ²¿ç”¨ç›¸åŒåˆ—ï¼‰
with open(
    os.path.join(OUT_DIR, "key_distances.csv"), "w", newline="", encoding="utf-8-sig"
) as f:
    w = csv.DictWriter(f, fieldnames=long_fields)
    w.writeheader()
    w.writerows(key_rows)

print(f"== æŽ¥è§¦åˆ†æžå®Œæˆ ==")
print(f"  å¤„ç† model æ•°: {len(manifest) - len(skip)}ï¼ˆè·³è¿‡ç¡¬å‰”é™¤ {len(skip)}ï¼‰")
print(f"  contacts_long.csv: {len(long_rows)} è¡Œ")
print(f"  key_distances.csv: {len(key_rows)} è¡Œ")

endstream
