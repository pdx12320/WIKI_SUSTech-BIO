# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 0 â€”â€” æ¸…å•å½’ä¸€åŒ–
æ‰«æ 3 ä¸ª RNA æ–‡ä»¶å¤¹ï¼Œç”Ÿæˆ manifest.csvï¼Œç»Ÿä¸€ seed ä¸Ž rankï¼Œå¹¶åšå®Œæ•´æ€§æ–­è¨€ã€‚

äº§å‡ºï¼šresults/manifest.csv
åˆ—ï¼šrna, seed, rank, path
"""
import os
import csv
import glob
import re

import af_utils as U

OUT_DIR = "results"
os.makedirs(OUT_DIR, exist_ok=True)

rows = []
problems = []

for rd in U.RNA_DIRS:
    # åªæŠŠåŒ…å« *_job_request.json çš„å­ç›®å½•å½“ä½œ seed ç›®å½•
    seed_dirs = [
        d
        for d in glob.glob(os.path.join(rd, "*/"))
        if glob.glob(os.path.join(d, "*_job_request.json"))
    ]

    for sd in sorted(seed_dirs):
        job = glob.glob(os.path.join(sd, "*_job_request.json"))[0]
        seed, rna, protein = U.read_job(job)

        models = sorted(glob.glob(os.path.join(sd, "*_model_[0-4].cif")))
        ranks = []
        for m in models:
            m2 = re.search(r"_model_(\d)\.cif$", m)
            rank = int(m2.group(1))
            ranks.append(rank)
            rows.append([rna, seed, rank, os.path.abspath(m)])

        if len(models) != 5 or sorted(ranks) != [0, 1, 2, 3, 4]:
            problems.append((rd, seed, len(models)))

# å†™å‡º manifest
with open(
    os.path.join(OUT_DIR, "manifest.csv"), "w", newline="", encoding="utf-8-sig"
) as f:
    w = csv.writer(f)
    w.writerow(["rna", "seed", "rank", "path"])
    w.writerows(rows)

# æ–­è¨€ä¸Žæ±‡æ€»
print("== manifest æ±‡æ€» ==")
from collections import Counter, defaultdict

by_rna = defaultdict(set)
for rna, seed, rank, path in rows:
    by_rna[rna].add(seed)

all_ok = True
for rna in U.RNA_SEQS:
    n_seed = len(by_rna[rna])
    n_model = sum(1 for r in rows if r[0] == rna)
    flag = "OK" if n_seed == 20 and n_model == 100 else "*** å¼‚å¸¸ ***"
    if flag != "OK":
        all_ok = False
    print(f"  {rna}: {n_seed} seeds, {n_model} models  [{flag}]")

print(f"  æ€»è®¡: {len(rows)} ä¸ª model cif")
if problems:
    print("*** ä»¥ä¸‹ seed çš„ model æ•°é‡å¼‚å¸¸ï¼š", problems)
    all_ok = False
if all_ok:
    print("  æ–­è¨€é€šè¿‡ï¼šæ¯æ¡ RNA 20 ä¸ªç‹¬ç«‹ seed Ã— 5 ä¸ª model = 100 ç»“æž„ã€‚")
else:
    print("  å­˜åœ¨å¼‚å¸¸ï¼Œè¯·å…ˆæ£€æŸ¥æ•°æ®å®Œæ•´æ€§ã€‚")
print("å†™å…¥ results/manifest.csv")

endstream
