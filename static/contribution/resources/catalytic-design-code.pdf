# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 3 â€”â€” æ±‡æ€»ç»Ÿè®¡ä¸Ž G/A å¯¹æ¯”

è¯»å– results/contacts_long.csvï¼Œäº§å‡ºï¼š
  results/contacts_frequency.csv â€”â€” æ¯ (RNA Ã— è›‹ç™½æ®‹åŸº) çš„æŽ¥è§¦é¢‘çŽ‡ + è·ç¦»ä¸­ä½æ•°
  results/g_a_comparison.csv    â€”â€” åŒä¸€æ®‹åŸºåœ¨ G ç»„ vs A ç»„çš„æŽ¥è§¦é¢‘çŽ‡å¯¹æ¯”

åˆ†ç»„å£å¾„ï¼š
  GUGCGCG  = "+1=G"ï¼ˆon-targetï¼‰
  GUGCACG  = "+1=A"ï¼ˆçº¯ +1 äº¤æ¢ï¼Œä¸»å¯¹ç…§ï¼‰
  AUGCAGC  = "+1=A"ï¼ˆ871 è„±é¶ï¼Œä¾§ç¿¼ä¸åŒï¼Œä½œè¡¥å……ï¼‰
  A_pooled = GUGCACG + AUGCAGC
"""
import os
import csv
from collections import defaultdict

import af_utils as U

OUT_DIR = "results"

RNA_GROUPS = {
    "GUGCGCG": "+1=G (on)",
    "GUGCACG": "+1=A (swap)",
    "AUGCAGC": "+1=A (off)",
}
G_RNA = "GUGCGCG"
A_PURE = "GUGCACG"
A_OFF = "AUGCAGC"
A_POOL = [A_PURE, A_OFF]


def median(xs):
    xs = sorted(xs)
    n = len(xs)
    if n == 0:
        return None
    if n % 2:
        return xs[n // 2]
    return (xs[n // 2 - 1] + xs[n // 2]) / 2.0


# è¯»å–
data = defaultdict(
    lambda: defaultdict(
        lambda: {
            "n": 0,
            "n_base5": 0,
            "n_full5": 0,
            "n_base4": 0,
            "n_base3p5": 0,
            "dists_base": [],
            "dists_full": [],
        }
    )
)
resn_map = {}

with open(os.path.join(OUT_DIR, "contacts_long.csv"), encoding="utf-8-sig") as f:
    for row in csv.DictReader(f):
        rna = row["rna"]
        resi = int(row["resi"])
        resn_map[resi] = row["resn"]
        d = data[rna][resi]
        d["n"] += 1
        if row["contact_base_5.0"] == "True":
            d["n_base5"] += 1
        if row["contact_base_4.0"] == "True":
            d["n_base4"] += 1
        if row["contact_base_3.5"] == "True":
            d["n_base3p5"] += 1
        if row["contact_full_5.0"] == "True":
            d["n_full5"] += 1
        if row["min_dist_base"] != "":
            d["dists_base"].append(float(row["min_dist_base"]))
        if row["min_dist_full"] != "":
            d["dists_full"].append(float(row["min_dist_full"]))

# 1) é¢‘çŽ‡è¡¨
freq_rows = []
for rna in U.RNA_SEQS:
    for resi in sorted(data[rna]):
        d = data[rna][resi]
        n = d["n"]
        freq_rows.append(
            {
                "rna": rna,
                "resi": resi,
                "resn": resn_map[resi],
                "n_model": n,
                "freq_base_3.5": round(d["n_base3p5"] / n, 3),
                "freq_base_4.0": round(d["n_base4"] / n, 3),
                "freq_base_5.0": round(d["n_base5"] / n, 3),
                "freq_full_5.0": round(d["n_full5"] / n, 3),
                "median_min_dist_base": (
                    "" if not d["dists_base"] else round(median(d["dists_base"]), 3)
                ),
                "median_min_dist_full": (
                    "" if not d["dists_full"] else round(median(d["dists_full"]), 3)
                ),
            }
        )

freq_fields = [
    "rna",
    "resi",
    "resn",
    "n_model",
    "freq_base_3.5",
    "freq_base_4.0",
    "freq_base_5.0",
    "freq_full_5.0",
    "median_min_dist_base",
    "median_min_dist_full",
]
with open(
    os.path.join(OUT_DIR, "contacts_frequency.csv"), "w", newline="", encoding="utf-8-sig"
) as f:
    w = csv.DictWriter(f, fieldnames=freq_fields)
    w.writeheader()
    w.writerows(freq_rows)


# 2) G/A å¯¹æ¯”è¡¨
def freq(rna, resi, key):
    d = data[rna].get(resi)
    if not d or d["n"] == 0:
        return 0.0
    return d[key] / d["n"]


all_resi = set()
for rna in U.RNA_SEQS:
    all_resi |= set(data[rna].keys())

comp_rows = []
for resi in sorted(all_resi):
    fG = freq(G_RNA, resi, "n_base5")
    fA_pure = freq(A_PURE, resi, "n_base5")
    fA_off = freq(A_OFF, resi, "n_base5")
    # pooled Aï¼šåˆå¹¶ä¸¤ä¸ª A ç»„çš„è®¡æ•°
    nA = data[A_PURE].get(resi, {}).get("n_base5", 0) + data[A_OFF].get(resi, {}).get(
        "n_base5", 0
    )
    nA_total = data[A_PURE].get(resi, {}).get("n", 0) + data[A_OFF].get(resi, {}).get(
        "n", 0
    )
    fA_pool = (nA / nA_total) if nA_total else 0.0

    comp_rows.append(
        {
            "resi": resi,
            "resn": resn_map[resi],
            "freq_G": round(fG, 3),
            "freq_A_swap": round(fA_pure, 3),
            "freq_A_off": round(fA_off, 3),
            "freq_A_pooled": round(fA_pool, 3),
            "delta_G_minus_Aswap": round(fG - fA_pure, 3),
            "delta_G_minus_Apooled": round(fG - fA_pool, 3),
        }
    )

comp_fields = [
    "resi",
    "resn",
    "freq_G",
    "freq_A_swap",
    "freq_A_off",
    "freq_A_pooled",
    "delta_G_minus_Aswap",
    "delta_G_minus_Apooled",
]
with open(
    os.path.join(OUT_DIR, "g_a_comparison.csv"), "w", newline="", encoding="utf-8-sig"
) as f:
    w = csv.DictWriter(f, fieldnames=comp_fields)
    w.writeheader()
    w.writerows(comp_rows)

# æŽ§åˆ¶å°ï¼šæ‰“å° +1 ç¢±åŸºæŽ¥è§¦é¢‘çŽ‡å‰ 20 çš„æ®‹åŸºï¼ˆæŒ‰ G ç»„é¢‘çŽ‡ï¼‰
print("== +1 ç¢±åŸº(â‰¤5Ã…)æŽ¥è§¦é¢‘çŽ‡ï¼šæŒ‰ G ç»„(GCG)æŽ’åºçš„å‰ 20 ä¸ªè›‹ç™½æ®‹åŸº ==")
print(f"{'resi':>5} {'resn':>4} {'G(on)':>7} {'A(swap)':>8} {'A(off)':>8} {'Î”G-A':>7}")
top = sorted(comp_rows, key=lambda r: -r["freq_G"])[:20]
for r in top:
    print(
        f"{r['resi']:>5} {r['resn']:>4} {r['freq_G']:>7} {r['freq_A_swap']:>8} "
        f"{r['freq_A_off']:>8} {r['delta_G_minus_Aswap']:>7}"
    )

print(f"\n== å…³é”®æ®‹åŸº G/A å¯¹æ¯” ==")
print(f"{'resi':>5} {'resn':>4} {'G(on)':>7} {'A(swap)':>8} {'A(off)':>8} {'Î”G-A':>7}")
for r in comp_rows:
    if r["resi"] in U.KEY_RESIDUES:
        print(
            f"{r['resi']:>5} {r['resn']:>4} {r['freq_G']:>7} {r['freq_A_swap']:>8} "
            f"{r['freq_A_off']:>8} {r['delta_G_minus_Aswap']:>7}"
        )

print("\nå†™å…¥ results/contacts_frequency.csv, results/g_a_comparison.csv")

endstream
