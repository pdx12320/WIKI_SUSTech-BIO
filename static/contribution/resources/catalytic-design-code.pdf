# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 19 â€”â€” çªå˜ä½“æ¨¡åž‹çš„ CP / Î”CP åˆ†æžï¼Œå¹¶ä¸Ž WT å¯¹æ¯”

å¯¹ new/mut/ ä¸‹æ¯ä¸ªçªå˜ï¼ˆÃ— GCG/GCA ä¸¤ motifï¼Œå„ 5 æ¨¡åž‹ï¼‰ï¼š
  æå–ã€Œè›‹ç™½æ®‹åŸº â†” +1 æ ¸è‹·é…¸(RNA res 5)ã€çš„ CPï¼›
  ç®— Î”CP = CP(GCA) - CP(GCG)ï¼›
  å¯¹æ¯” WT çš„ Î”CPï¼Œçœ‹çªå˜æ˜¯å¦æ”¹å˜ +1 G/A åˆ¤åˆ«ã€‚

äº§å‡ºï¼šresults/mut_cp_dcp.csvï¼ˆæ¯çªå˜ Ã— æ®‹åŸºçš„ CP_G/CP_A/Î”CPï¼‰
"""
import json
import csv
import os
import glob
from collections import defaultdict

import af_utils as U

OUT = "results"
PLUS1_RESI = 5

# çªå˜åˆ—è¡¨ï¼ˆnew/mut ä¸‹çš„ç›®å½•åï¼‰
MUTS = [
    "a59p",
    "g25e",
    "g25ek30h",
    "g27d",
    "g27dk30h",
    "g27dk30hq58m",
    "g27t",
    "g27tk30h",
    "g27tk30hq58m",
    "k30h",
    "k30hq58m",
    "k60r",
    "m132d",
    "m132e",
]


def process(dirname):
    cp = defaultdict(list)
    for fjson in sorted(glob.glob(os.path.join(dirname, "*full_data*.json"))):
        d = json.load(open(fjson, encoding="utf-8"))
        cids = d["token_chain_ids"]
        rids = d["token_res_ids"]
        cpm = d["contact_probs"]
        tgt = next(
            i
            for i in range(len(cids))
            if cids[i] == U.RNA_CHAIN and rids[i] == PLUS1_RESI
        )
        for i in range(len(cids)):
            if cids[i] == U.PROT_CHAIN:
                cp[rids[i]].append(max(cpm[i][tgt], cpm[tgt][i]))
    return {r: sum(v) / len(v) for r, v in cp.items()}


# è¯» WT å‚è€ƒï¼ˆresults/cp_dcp.csvï¼‰
wt = {}
for r in csv.DictReader(open(f"{OUT}/cp_dcp.csv", encoding="utf-8-sig")):
    wt[int(r["resi"])] = dict(
        cp_G=float(r["cp_G"]), cp_A=float(r["cp_A_swap"]), dcp=float(r["dcp_swap"])
    )

# è®¡ç®—æ¯ä¸ªçªå˜
result = {}
for m in MUTS:
    g = process(f"new/mut/{m}_gcg")
    a = process(f"new/mut/{m}_gca")
    resis = set(g) | set(a)
    result[m] = {
        r: dict(cpG=g.get(r, 0), cpA=a.get(r, 0), dcp=a.get(r, 0) - g.get(r, 0))
        for r in resis
    }

# è¾“å‡º CSV
with open(f"{OUT}/mut_cp_dcp.csv", "w", newline="", encoding="utf-8-sig") as f:
    w = csv.writer(f)
    w.writerow(["mut", "resi", "cp_G", "cp_A", "dcp", "wt_cpG", "wt_cpA", "wt_dcp"])
    for m in MUTS:
        for r in sorted(result[m]):
            d = result[m][r]
            ww = wt.get(r, {})
            w.writerow(
                [
                    m,
                    r,
                    round(d["cpG"], 4),
                    round(d["cpA"], 4),
                    round(d["dcp"], 4),
                    round(ww.get("cp_G", 0), 4),
                    round(ww.get("cp_A", 0), 4),
                    round(ww.get("dcp", 0), 4),
                ]
            )

# æ‰“å°å…³é”®æ®‹åŸºçš„ Î”CP å¯¹æ¯”
KEYS = [27, 28, 29, 30, 31, 32, 57, 58, 59, 60, 70, 72, 99, 102, 105, 129, 130, 132]
print("== å„çªå˜çš„ Î”CPï¼ˆ+1 ä½ï¼Œæ­£å€¼=æŽ’Aæ–¹å‘ï¼Œè´Ÿå€¼=ä¿Gæ–¹å‘ï¼‰å…³é”®æ®‹åŸº ==")
print(f"{'çªå˜':<16}", end="")
for k in KEYS:
    print(f"{k:>5}", end="")
print(f"{'  (vs WT å˜åŒ–)':>18}")
for m in MUTS:
    print(f"{m:<16}", end="")
    for k in KEYS:
        d = result[m].get(k, {})
        print(f"{d.get('dcp',0):>+5.2f}", end="")
    # ä¸Ž WT çš„å·®å¼‚ï¼ˆå…³é”®æ®‹åŸº 29/30 çš„ Î”CP å˜åŒ–ï¼‰
    d30 = result[m].get(30, {}).get('dcp', 0) - wt.get(30, {}).get('dcp', 0)
    d29 = result[m].get(29, {}).get('dcp', 0) - wt.get(29, {}).get('dcp', 0)
    print(f"  (Î”Î”CP 29={d29:+.2f} 30={d30:+.2f})")
print(f"{'WT(å‚è€ƒ)':<16}", end="")
for k in KEYS:
    print(f"{wt.get(k,{}).get('dcp',0):>+5.2f}", end="")
print()
print(f"\nå†™å…¥ {OUT}/mut_cp_dcp.csv")

endstream
