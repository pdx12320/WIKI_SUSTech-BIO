    except ValueError:
        pass
# ç»„åˆå¹²é¢„æµ‹ï¼ˆç›¸ä¹˜æ¨¡åž‹ï¼‰
pred_combo = {}
for r in load("results/combinations_top1000.csv"):
    pred_combo[r["mutations"].replace("+", "-").replace("G", "G")] = float(r["est_ratio"])
# GCG å£å¾„
