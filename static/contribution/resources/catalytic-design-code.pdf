# -*- coding: utf-8 -*-
"""
AF3 cif è´¨æŽ§ + æŽ¥è§¦åˆ†æž å…±äº«å·¥å…·ï¼ˆçº¯æ ‡å‡†åº“ï¼Œæ— ç¬¬ä¸‰æ–¹ä¾èµ–ï¼‰ã€‚

æ•°æ®çº¦å®šï¼ˆå·²å¯¹ç…§å®žé™…æ–‡ä»¶æ ¸å®žï¼‰ï¼š
- è›‹ç™½é“¾ chain Aï¼ˆasym_id "A"ï¼‰ï¼Œ199 æ®‹åŸºï¼Œç¼–å· 1..199ï¼Œä¸Ž FASTA ç¼–å· 1:1 å¯¹åº”ã€‚
- RNA é“¾  chain Bï¼ˆasym_id "B"ï¼‰ï¼Œ7 ä¸ªæ ¸è‹·é…¸ï¼Œç¼–å· 1..7ã€‚
- ç¼–è¾‘ C ä¸º 0 ä½ = resi 4ï¼›+1 ä½ = resi 5ï¼ˆä¸‰ä¸ª RNA æ¨¡åž‹ä¸€è‡´ï¼‰ã€‚
- cif æ— æ°¢åŽŸå­ï¼Œåªæœ‰ C/N/O/P/S é‡åŽŸå­ï¼Œæ•…"é‡åŽŸå­è·ç¦»"= å…¨éƒ¨åŽŸå­è·ç¦»ã€‚
- pLDDT å­˜äºŽ _atom_site.B_iso_or_equiv åˆ—ã€‚
"""
import json
import os

# ä¸‰ä¸ª RNA æ–‡ä»¶å¤¹ï¼ˆä»… RNA åºåˆ—ä¸åŒï¼Œè›‹ç™½åºåˆ—ç›¸åŒï¼‰
RNA_DIRS = ["GUGCGCG_20", "GUGCACG_20", "AUGCAGC_20"]

# å¯¹åº”çš„ RNA åºåˆ—ï¼ˆmanifest / æ±‡æ€»ä¸­ä½œä¸º RNA æ ‡è¯†ï¼Œéžæ–‡ä»¶å¤¹åï¼‰
RNA_SEQS = ["GUGCGCG", "GUGCACG", "AUGCAGC"]

# +1 ä½æ®‹åŸºç¼–å·ï¼ˆRNA é“¾ chain Bï¼‰
PLUS1_RESI = 5

# é“¾æ ‡è¯†
PROT_CHAIN = "A"
RNA_CHAIN = "B"

# å˜Œå‘¤ç¢±åŸºé‡åŽŸå­ï¼ˆG/A å¹¶é›†ï¼Œç¨‹åºæŒ‰å®žé™…å­˜åœ¨çš„åŽŸå­è‡ªåŠ¨å–ï¼‰
BASE_ATOMS = {"N9", "C8", "N7", "C5", "C6", "N6", "O6", "N1", "C2", "N2", "N3", "C4"}

# ç¢±åŸºå®Œæ•´æ€§åˆ¤æ®ï¼š+1 ä¸º G æˆ– A æ—¶å„è‡ªåº”å…·å¤‡çš„å…¨éƒ¨ç¢±åŸºé‡åŽŸå­
PURINE_BASE = {
    "G": {"N9", "C8", "N7", "C5", "C6", "O6", "N1", "C2", "N2", "N3", "C4"},
    "A": {"N9", "C8", "N7", "C5", "C6", "N6", "N1", "C2", "N3", "C4"},
}

# å…³é”®æ®‹åŸºï¼ˆresi -> æœŸæœ› resnï¼‰ã€‚ç¼–å·å·²æŒ‰ cif/FASTA 1:1 æ ¸å¯¹ã€‚
# æ³¨æ„ï¼šäº¤æŽ¥æ–‡æ¡£ä¸­çš„ "R67" åº”ä¸º Y67ï¼ˆ67 ä½åœ¨åºåˆ—/ç»“æž„ä¸­å‡ä¸º Tyrï¼Œéž Argï¼‰ã€‚
KEY_RESIDUES = {
    29: "HIS",
    30: "LYS",
    32: "TYR",
    57: "ASN",
    58: "GLN",
    59: "ALA",
    60: "LYS",
    67: "TYR",
    68: "GLY",
    69: "ARG",
    70: "HIS",
    72: "GLU",
    99: "TRP",
}

# æŽ¥è§¦åˆ†æžè·ç¦»é˜ˆå€¼ï¼ˆÃ…ï¼‰
CUTOFFS = [3.5, 4.0, 5.0]


# ---------------------------------------------------------------------------
# JSON / cif è¯»å–
# ---------------------------------------------------------------------------
def read_job(job_json_path):
    """ä»Ž *_job_request.json è¯»å– (seed, rna_sequence, protein_sequence)ã€‚

    æ³¨æ„ï¼šseed å¿…é¡»ä»Ž job_request è¯»å–ï¼Œç›®å½•åä¸å¯é ã€‚
    """
    with open(job_json_path, "r", encoding="utf-8") as f:
        d = json.load(f)[0]
    seed = str(d["modelSeeds"][0])
    rna = d["sequences"][1]["rnaSequence"]["sequence"]
    protein = d["sequences"][0]["proteinChain"]["sequence"]
    return seed, rna, protein


def parse_atom_site(cif_path):
    """è§£æž cif çš„ _atom_site å¾ªçŽ¯ã€‚

    è¿”å›ž (columns, rows)ï¼š
    - columns: å½¢å¦‚ ["atom_site.group_PDB", "atom_site.id", ...] çš„åˆ—ååˆ—è¡¨
    - rows:    [{col_name: value}, ...]ï¼Œvalue å·²åŽ»é™¤é¦–å°¾å¼•å·
    """
    cols = []
    rows = []
    started = False
    with open(cif_path, "r", encoding="utf-8") as f:
        for line in f:
            s = line.rstrip("\n")
            if s.startswith("_atom_site."):
                cols.append(s[1:])  # åŽ»æŽ‰å‰å¯¼ä¸‹åˆ’çº¿
                started = True
                continue
            if started:
                if s.startswith(("ATOM", "HETATM")):
                    parts = s.split()
                    rec = {}
                    for c, v in zip(cols, parts):
                        rec[c] = v.strip('"')
                    rows.append(rec)
                else:
                    break  # æ•°æ®è¡Œç»“æŸ
    return cols, rows


# ---------------------------------------------------------------------------
# åŽŸå­ç­›é€‰ä¸Žå‡ ä½•
# ---------------------------------------------------------------------------
def atoms_of(rows, chain, resid=None, names=None, resn=None):
    """æŒ‰ chain / resid / åŽŸå­å / æ®‹åŸºå è¿‡æ»¤åŽŸå­ã€‚"""
    out = []
    for a in rows:
        if a.get("atom_site.label_asym_id") != chain:
            continue
        if resid is not None and int(a["atom_site.label_seq_id"]) != resid:
            continue
        if names is not None and a.get("atom_site.label_atom_id") not in names:
            continue
        if resn is not None and a.get("atom_site.label_comp_id") not in resn:
            continue
        out.append(a)
    return out


def residues_by_chain(rows, chain):
    """è¿”å›ž {resi: [atom_dict, ...]}ï¼ŒæŒ‰é“¾åˆ†ç»„ã€‚"""
    res = {}
    for a in rows:
        if a.get("atom_site.label_asym_id") != chain:
            continue
        resi = int(a["atom_site.label_seq_id"])
        res.setdefault(resi, []).append(a)
    return res


def coord(a):
    return (
        float(a["atom_site.Cartn_x"]),
        float(a["atom_site.Cartn_y"]),
        float(a["atom_site.Cartn_z"]),
    )


def min_dist(atoms_a, atoms_b):
    """ä¸¤ä¸ªåŽŸå­åˆ—è¡¨é—´çš„æœ€å°é‡åŽŸå­è·ç¦»ï¼›ä»»ä¸€ä¾§ä¸ºç©ºè¿”å›ž Noneã€‚"""
    if not atoms_a or not atoms_b:
        return None
    best = None
    for a in atoms_a:
        xa, ya, za = coord(a)
        for b in atoms_b:
            xb, yb, zb = coord(b)
            dx, dy, dz = xa - xb, ya - yb, za - zb
            d = dx * dx + dy * dy + dz * dz
            if best is None or d < best:
                best = d
    return best**0.5


def atom_plddt(a):
    """è¿”å›žå•ä¸ªåŽŸå­çš„ pLDDTï¼ˆB-factor åˆ—ï¼‰ã€‚"""
    try:
        return float(a["atom_site.B_iso_or_equiv"])
    except (KeyError, ValueError):
        return None

endstream
