def paint(ws, r0, c0, nr, nc, arr, hi=0.15, lo=-0.10):
    for i in range(nr):
        for j in range(nc):
            v = arr[i, j]
            if v >= hi:
                ws.cell(r0 + i, c0 + j).fill = RED
            elif v <= lo:
                ws.cell(r0 + i, c0 + j).fill = BLU


# --- Sheet1 Î”CP çŸ©é˜µ ---
ws = wb.active
