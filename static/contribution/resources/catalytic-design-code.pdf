# -*- coding: utf-8 -*-
"""
é˜¶æ®µ 10 â€”â€” å·®å¼‚æŽ¥è§¦çš„ã€ŒæŽ¥è§¦ç±»åž‹ã€åˆ†è§£

å¯¹æ¯ä¸ªä¸Ž +1 æ ¸è‹·é…¸æŽ¥è§¦çš„è›‹ç™½æ®‹åŸºï¼ŒæŠŠæŽ¥è§¦æ‹†æˆï¼š
  è›‹ç™½ä¾§  Ã—  RNA ä¾§
  ä¾§é“¾(sidechain) / ä¸»é“¾(backbone)  Ã—  ç¢±åŸº(base) / ç³–(sugar) / ç£·é…¸(phosphate)

ç›®çš„ï¼šåŒºåˆ†ã€Œå¯è®¾è®¡ã€çš„ç¢±åŸºç‰¹å¼‚ä¾§é“¾æŽ¥è§¦ vs ã€Œç»“æž„æ€§ã€çš„ä¸»é“¾/ç³–ç£·é…¸æŽ¥è§¦ã€‚
  - ä¾§é“¾-ç¢±åŸºæŽ¥è§¦ = å¯è®¾è®¡ï¼ˆå¯é€šè¿‡çªå˜ä¾§é“¾è°ƒè°ç¢±åŸºç‰¹å¼‚æ€§ï¼‰
  - ä¸»é“¾æŽ¥è§¦     = ç»“æž„æ€§ï¼ˆçªå˜ä¾§é“¾æ”¹ä¸åŠ¨éª¨æž¶ï¼ŒåŸºæœ¬ä¸å¯è®¾è®¡ï¼‰

äº§å‡ºï¼šresults/contact_decomposition.csv
"""
import os
import csv
from collections import defaultdict

import af_utils as U

OUT = "results"

# è›‹ç™½åŽŸå­åˆ†ç±»
BB = {"N", "CA", "C", "O", "OXT"}
# RNA åŽŸå­åˆ†ç±»
BASE = {"N1", "C2", "N3", "C4", "C5", "C6", "N7", "C8", "N9", "O6", "N2", "N6"}
SUGAR = {"C1'", "C2'", "O2'", "C3'", "O3'", "C4'", "O4'", "C5'", "O5'"}
PHOS = {"P", "OP1", "OP2"}

CUTOFF = 5.0


def classify_prot(name):
    return "bb" if name in BB else "sc"


def classify_rna(name):
    if name in BASE:
        return "base"
    if name in SUGAR:
        return "sugar"
    if name in PHOS:
        return "phos"
    return "other"


def contact_type(prot_atoms, rna_atoms):
    """è¿”å›ž (has_sc_base, has_bb_base, has_sc_sugphos, has_bb_sugphos)ã€‚"""
    sc_base = bb_base = sc_sp = bb_sp = False
    for pa in prot_atoms:
        pcls = classify_prot(pa["atom_site.label_atom_id"])
        pc = U.coord(pa)
        for ra in rna_atoms:
            rcls = classify_rna(ra["atom_site.label_atom_id"])
            rc = U.coord(ra)
            dx, dy, dz = pc[0] - rc[0], pc[1] - rc[1], pc[2] - rc[2]
            if (dx * dx + dy * dy + dz * dz) ** 0.5 > CUTOFF:
                continue
            if pcls == "sc" and rcls == "base":
                sc_base = True
            elif pcls == "bb" and rcls == "base":
                bb_base = True
            elif pcls == "sc" and rcls in ("sugar", "phos"):
                sc_sp = True
            elif pcls == "bb" and rcls in ("sugar", "phos"):
                bb_sp = True
    return sc_base, bb_base, sc_sp, bb_sp


# è¯» manifestï¼ˆè·³è¿‡ä¸å¿…è¦ï¼Œå…¨éƒ¨å¤„ç†ï¼‰
manifest = list(
    csv.DictReader(open(os.path.join(OUT, "manifest.csv"), encoding="utf-8-sig"))
)

# èšåˆï¼šrna -> resi -> å„ç±»åž‹è®¡æ•°
agg = defaultdict(
    lambda: defaultdict(lambda: [0, 0, 0, 0])
)  # [sc_base, bb_base, sc_sp, bb_sp]
nmodel = defaultdict(int)
resn_map = {}

for m in manifest:
    rna = m["rna"]
    nmodel[rna] += 1
    cols, atoms = U.parse_atom_site(m["path"])
    plus1 = U.atoms_of(atoms, U.RNA_CHAIN, U.PLUS1_RESI)
    rA = U.residues_by_chain(atoms, U.PROT_CHAIN)
    for resi, patoms in rA.items():
        resn_map[resi] = patoms[0]["atom_site.label_comp_id"]
        sc_base, bb_base, sc_sp, bb_sp = contact_type(patoms, plus1)
        a = agg[rna][resi]
        a[0] += sc_base
        a[1] += bb_base
        a[2] += sc_sp
        a[3] += bb_sp

# å†™ CSVï¼šæ¯ RNA Ã— æ®‹åŸº çš„é¢‘çŽ‡
rows = []
for rna in U.RNA_SEQS:
    for resi in sorted(agg[rna]):
        a = agg[rna][resi]
        n = nmodel[rna]
        sc_base = round(a[0] / n, 2)
        bb_base = round(a[1] / n, 2)
        sc_sp = round(a[2] / n, 2)
        bb_sp = round(a[3] / n, 2)
        # è®¾è®¡æ€§ï¼šä¾§é“¾-ç¢±åŸºæŽ¥è§¦é«˜ = å¯è®¾è®¡ç‰¹å¼‚æ€§ï¼›ä¸»é“¾ä¸ºä¸» = ç»“æž„æ€§
        if sc_base >= 0.5 and bb_base < sc_base:
            tag = "å¯è®¾è®¡(ä¾§é“¾-ç¢±åŸºç‰¹å¼‚)"
        elif bb_base >= 0.5 or bb_sp >= 0.5:
            tag = "ç»“æž„æ€§(ä¸»é“¾/ç³–ç£·é…¸ä¸ºä¸»)"
        elif sc_sp >= 0.5:
            tag = "å¯è®¾è®¡(ä¾§é“¾-ç³–ç£·é…¸)"
        else:
            tag = ""
        rows.append(
            dict(
                rna=rna,
                resi=resi,
                resn=resn_map[resi],
                sc_base=sc_base,
                bb_base=bb_base,
                sc_sugphos=sc_sp,
                bb_sugphos=bb_sp,
                designability=tag,
            )
        )

with open(f"{OUT}/contact_decomposition.csv", "w", newline="", encoding="utf-8-sig") as f:
    w = csv.DictWriter(
        f,
        fieldnames=[
            "rna",
            "resi",
            "resn",
            "sc_base",
            "bb_base",
            "sc_sugphos",
            "bb_sugphos",
            "designability",
        ],
    )
    w.writeheader()
    w.writerows(rows)

# èšç„¦å…³é”®/å€™é€‰æ®‹åŸº
KEYS = [
    27,
    28,
    29,
    30,
    31,
    32,
    57,
    58,
    59,
    60,
    67,
    68,
    69,
    70,
    72,
    98,
    99,
    102,
    105,
    129,
    130,
    131,
    132,
    133,
]
print("== å…³é”®æ®‹åŸº æŽ¥è§¦ç±»åž‹åˆ†è§£ï¼ˆA-swap GUGCACGï¼Œé¢‘çŽ‡ 0-1ï¼‰==")
print(
    f"{'resi':>4} {'resn':>4} {'ä¾§é“¾-ç¢±åŸº':>8} {'ä¸»é“¾-ç¢±åŸº':>8} {'ä¾§é“¾-ç³–ç£·':>8} {'ä¸»é“¾-ç³–ç£·':>8}  è®¾è®¡æ€§"
)
for r in rows:
    if (
        r["rna"] == "GUGCACG"
        and r["resi"] in KEYS
        and (
            r["sc_base"] > 0
            or r["bb_base"] > 0
            or r["sc_sugphos"] > 0
            or r["bb_sugphos"] > 0
        )
    ):
        print(
            f"{r['resi']:>4} {r['resn']:>4} {r['sc_base']:>8.2f} {r['bb_base']:>8.2f} "
            f"{r['sc_sugphos']:>8.2f} {r['bb_sugphos']:>8.2f}  {r['designability']}"
        )

print(f"\nå†™å…¥ {OUT}/contact_decomposition.csv")

endstream
