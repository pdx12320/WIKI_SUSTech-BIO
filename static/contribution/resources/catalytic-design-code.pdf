èƒŒæ™¯ï¼ˆCycle 3ï¼‰ï¼š
  æˆ‘ä»¬æ­¤å‰å‘çŽ° targeting_ratio = Î£_GCG / Î£_nonGCG è¢« 5% æ£€æµ‹ä¸‹é™æ··æ·†â€”â€”
  é…¶æ•´ä½“æ´»æ€§ä¸‹é™æ—¶ï¼Œè„±é¶ä½ç‚¹çŽ‡å…ˆæŽ‰åˆ°æ£€å‡ºçº¿ä¸‹è¢«è®°ä¸º 0ï¼Œåˆ†æ¯å¡Œç¼©ã€æ¯”å€¼è™šé«˜ã€‚
  å½“æ—¶æˆ‘ä»¬ç¡®ç«‹äº†ä¸¤æ¡è§„åˆ™å¹¶**åº”ç”¨**äº†ä¸‹é™ï¼ˆè§ 25_offtarget_screen.py:96ï¼Œ
  `if r["on"] < 0.30: continue`ï¼‰ï¼Œä½†ä»Žæœªå›žè¡¥æ£€éªŒä¸¤ä»¶äº‹ï¼š
    (1) åŠ äº†æ´»æ€§ä¸‹é™ä¹‹åŽï¼Œåå€šæ˜¯å¦çœŸçš„è¢«æ¶ˆé™¤ï¼Ÿ
    (2) è‹¥æŒ‰æ ¡æ­£åŽçš„æŒ‡æ ‡é‡æ–°æŽ’åºï¼Œé€‰å‡ºçš„å€™é€‰ä¼šä¸ä¼šä¸ŽåŽŸå§‹æŽ’åºä¸åŒï¼Ÿ

æœ¬è„šæœ¬è¡¥åšè¿™ä¸¤ä»¶äº‹ã€‚

ã€å›žè¡¥æ£€éªŒ Part 1ã€‘åå€šæ˜¯å¦è¢«ä¸‹é™æ¶ˆé™¤
  æ¯”è¾ƒã€Œå…¨é‡ã€ä¸Žã€ŒåŠ ä¸‹é™ C388 â‰¥ 0.30ã€ä¸¤ç§å£å¾„ä¸‹ï¼š
    Â· Pearson/Spearman(é¶å‘æ¯”, Î£éžGCG)
    Â· Pearson(C388%, Î£éžGCG%)
    Â· ä½Ž/é«˜æ´»æ€§å±‚é¶å‘æ¯”ä¸­ä½æ•°
    Â· æ¯”å€¼ = âˆž çš„æž„å»ºä½“æ•°

ã€å›žè¡¥æ£€éªŒ Part 2ã€‘å…­ç§æŽ’åºå£å¾„çš„å¯¹æ¯”ä¸Žç¨³å¥å€™é€‰
  (a) åŽŸå§‹ targeting_ratio
  (b) åŠ æ´»æ€§ä¸‹é™çš„ targeting_ratio
  (c) æ´»æ€§æ®‹å·®åŒ–ï¼ˆå¯¹ C388% å›žå½’å–æ®‹å·®ï¼‰
  (d) å¹³å‡éž GCG ç¼–è¾‘çŽ‡ï¼ˆÎ£/n_detectedï¼Œå‡è½»åˆ†æ¯å¡Œç¼©ï¼‰
  (e) å½’ä¸€åŒ–è„±é¶è´Ÿè· Î£off/onï¼ˆ25 è„šæœ¬å®žé™…ä½¿ç”¨çš„å£å¾„ï¼‰
  (f) +1 æ¯”ï¼ˆGCG/GCAï¼Œå•ç‚¹å¯¹å•ç‚¹ï¼Œç‹¬ç«‹äºŽæ‰©å¢žå­æŒ‡æ ‡ï¼‰
  å¯¹æ¯”å„è‡ª top-10 çš„é‡å åº¦ï¼ŒåŒºåˆ†ã€Œç¨³å¥å€™é€‰ã€ä¸Žã€ŒåŽŸå§‹æŽ’åºä¼ªå½±ã€ã€‚

äº§å‡ºï¼šresults/é¶å‘æ¯”_å›žè¡¥æ£€éªŒ.csv
      results/é¶å‘æ¯”_é‡æŽ’åºå¯¹æ¯”.csv
"""
import csv, math, sys

sys.stdout.reconfigure(encoding="utf-8")
import numpy as np
from scipy import stats as st

SRC = "results/GCG_vs_off_ranking_WT.csv"
OFF = "results/offtarget_by_mutant.csv"
CMB = "results/23_combo_master_table.csv"
FLOOR = 0.30
OUT1, OUT2 = "results/é¶å‘æ¯”_å›žè¡¥æ£€éªŒ.csv", "results/é¶å‘æ¯”_é‡æŽ’åºå¯¹æ¯”.csv"


def F(x):
    try:
        v = float(x)
        return v if math.isfinite(v) else None
    except (TypeError, ValueError):
        return None


def rd(p):
    with open(p, encoding="utf-8-sig") as f:
        return list(csv.DictReader(f))


# ---------- è½½å…¥ ----------
rows = [r for r in rd(SRC) if r["is_WT"] != "True"]
off = {r["mutant"]: r for r in rd(OFF)}
p1 = {r["muts"]: F(r["ratio_p1"]) for r in rd(CMB)}

for r in rows:
    r["_c388"] = F(r["C388_pct"])
    r["_tr"] = F(r["targeting_ratio"])
    r["_off"] = F(r["sum_nonGCG_pct"])
    r["_ngcg"] = F(r["n_nonGCG_detected"])
    r["_ng"] = F(r["n_GCG_detected"])
    r["_act"] = F(r["activity_retention"])
    o = off.get(r["mutation"], {})
    r["_offsum"] = F(o.get("off_sum"))
    r["_on388"] = F(o.get("on_388"))
    r["_p1"] = p1.get(r["mutation"])

has_off = [r for r in rows if r["_off"] is not None]
fin = [r for r in has_off if r["_tr"] is not None]
keep = [r for r in fin if r["_c388"] is not None and r["_c388"] >= FLOOR * 100]
print(
    f"ç»„åˆæž„å»ºä½“ {len(rows)} ä¸ªï¼›æœ‰ Î£ éžGCG è¯»æ•° {len(has_off)}ï¼›æ¯”å€¼æœ‰é™ {len(fin)}ï¼›"
    f"å†åŠ  C388 â‰¥ {FLOOR*100:.0f}% åŽ {len(keep)}"
)

# ===========================================================================
# Part 1 â€”â€” åå€šæ˜¯å¦è¢«ä¸‹é™æ¶ˆé™¤
# ===========================================================================
print("\n" + "=" * 96)
print("Part 1ã€€å›žè¡¥æ£€éªŒï¼šåŠ æ´»æ€§ä¸‹é™åŽï¼Œåå€šè¢«æ¶ˆé™¤äº†å—ï¼Ÿ")
print("=" * 96)

res1 = []


def part1(tag, sub):
    off_a = np.array([r["_off"] for r in sub])
    tr_a = np.array([r["_tr"] for r in sub])
    c3_a = np.array([r["_c388"] for r in sub])
    if len(sub) < 5:
        return
    rp = float(np.corrcoef(off_a, tr_a)[0, 1])
    rs = float(st.spearmanr(off_a, tr_a)[0])
    cp = float(np.corrcoef(c3_a, off_a)[0, 1])
    lo = [r["_tr"] for r in sub if 10 <= r["_c388"] <= 20]
    hi = [r["_tr"] for r in sub if 35 <= r["_c388"] <= 60]
    n_inf = sum(
        1
        for r in rows
        if r["_c388"] is not None
        and r["_c388"] >= (FLOOR * 100 if tag.startswith("åŠ ä¸‹é™") else 0)
        and r["_tr"] is None
        and r["_off"] is not None
    )
    med_lo = float(np.median(lo)) if lo else float("nan")
    med_hi = float(np.median(hi)) if hi else float("nan")
    print(f"\nã€{tag}ã€‘n = {len(sub)}")
    print(f"  Spearman Ï(é¶å‘æ¯”, Î£éžGCG) = {rs:+.3f}    Pearson r = {rp:+.3f}")
    print(f"  Pearson  r(C388%, Î£éžGCG%)  = {cp:+.3f}")
    print(
        f"  ä½Žæ´»æ€§å±‚(10â€“20%) ä¸­ä½ {med_lo:.2f} (n={len(lo)})   "
        f"é«˜æ´»æ€§å±‚(35â€“60%) ä¸­ä½ {med_hi:.2f} (n={len(hi)})   å±‚é—´æ¯” {med_lo/med_hi:.2f}Ã—"
    )
    print(f"  è¯¥å£å¾„ä¸‹æ¯”å€¼ = âˆž çš„æž„å»ºä½“ï¼š{n_inf} ä¸ª")
    res1.append(
        dict(
            å£å¾„=tag,
            n=len(sub),
            Spearman_é¶å‘æ¯”_éžGCG=round(rs, 3),
            Pearson_é¶å‘æ¯”_éžGCG=round(rp, 3),
            Pearson_C388_éžGCG=round(cp, 3),
            ä½Žæ´»æ€§å±‚ä¸­ä½=round(med_lo, 2),
            ä½Žæ´»æ€§å±‚n=len(lo),
            é«˜æ´»æ€§å±‚ä¸­ä½=round(med_hi, 2),
            é«˜æ´»æ€§å±‚n=len(hi),
            å±‚é—´å€æ•°=round(med_lo / med_hi, 2) if med_hi else None,
            æ¯”å€¼æ— ç©·æ•°=n_inf,
        )
    )


part1("å…¨é‡ï¼ˆä¸è¿‡æ»¤ï¼‰", fin)
part1(f"åŠ ä¸‹é™ C388 â‰¥ {FLOOR*100:.0f}%", keep)

# ===========================================================================
# Part 2 â€”â€” å…­ç§å£å¾„çš„é‡æ–°æŽ’åº
# ===========================================================================
print("\n" + "=" * 96)
print("Part 2ã€€é‡æ–°æŽ’åºï¼šå…­ç§å£å¾„ä¸‹çš„ top-10")
print("=" * 96)

sub = [r for r in keep if r["_p1"] is not None or True]
# (c) æ´»æ€§æ®‹å·®åŒ–
c3 = np.array([r["_c388"] for r in keep])
tr = np.array([r["_tr"] for r in keep])
z = np.polyfit(c3, tr, 1)
resid = tr - np.polyval(z, c3)
for r, e in zip(keep, resid):
    r["_resid"] = float(e)


def score(r, key):
    if key == "a":
        return r["_tr"]
    if key == "b":
        return r["_tr"]
    if key == "c":
        return r["_resid"]
    if key == "d":
        n = r["_ngcg"] or 0
        return (r["_off"] / n) if n > 0 else None
    if key == "e":
        o, on = r["_offsum"], r["_on388"]
        return (o / on) if (o is not None and on and on > 0) else None
    if key == "f":
        return r["_p1"]
    return None


NAMES = {
    "a": "åŽŸå§‹ targeting_ratioï¼ˆå…¨é‡ï¼‰",
    "b": f"targeting_ratio + æ´»æ€§ä¸‹é™",
    "c": "æ´»æ€§æ®‹å·®åŒ–æ¯”å€¼",
    "d": "å¹³å‡éžGCGç¼–è¾‘çŽ‡ Î£/n",
    "e": "å½’ä¸€åŒ–è„±é¶è´Ÿè· Î£off/on",
    "f": "+1 æ¯”ï¼ˆç‹¬ç«‹å£å¾„ï¼‰",
}
POOL = {"a": fin, "b": keep, "c": keep, "d": keep, "e": keep, "f": keep}

top = {}
for k in "abcdef":
    pool = POOL[k]
    scored = [(r, score(r, k)) for r in pool]
    scored = [(r, s) for r, s in scored if s is not None]
    asc = k in ("d", "e")  # è¿™ä¸¤ç§è¶Šä½Žè¶Šå¥½
    scored.sort(key=lambda t: t[1], reverse=not asc)
    top[k] = [r["mutation"] for r, _ in scored[:10]]
    print(
        f"\n({k}) {NAMES[k]}ã€€ï¼ˆn = {len(scored)}{'ï¼Œè¶Šä½Žè¶Šå¥½' if asc else 'ï¼Œè¶Šé«˜è¶Šå¥½'}ï¼‰"
    )
    print("     " + "  ".join(f"{i+1}.{m}" for i, m in enumerate(top[k])))

# é‡å åº¦çŸ©é˜µ
print("\n" + "=" * 96)
print("top-10 é‡å åº¦ï¼ˆ|Aâˆ©B| / 10ï¼‰")
print("=" * 96)
ks = list("abcdef")
print("        " + "".join(f"{k:>7}" for k in ks))
for a in ks:
    line = f"  ({a})   "
    for b in ks:
        ov = len(set(top[a]) & set(top[b]))
        line += f"{ov:>7}"
    print(line)

# ç¨³å¥ vs ä¼ªå½±
cnt = {}
for k in ks:
    for m in top[k]:
        cnt[m] = cnt.get(m, 0) + 1
robust = sorted([m for m, c in cnt.items() if c >= 4], key=lambda m: -cnt[m])
artifact = [m for m in top["a"] if cnt.get(m, 0) <= 2]
print(f"\nâ˜… ç¨³å¥å€™é€‰ï¼ˆåœ¨ â‰¥4 ç§å£å¾„ä¸­éƒ½è¿› top-10ï¼Œå…± {len(robust)} ä¸ªï¼‰ï¼š")
for m in robust:
    r = next(x for x in keep if x["mutation"] == m)
    print(
        f"    {m:<20} å‘½ä¸­ {cnt[m]}/6 ç§å£å¾„   é¶å‘æ¯” {r['_tr']:.2f}   C388 {r['_c388']:.1f}%"
        f"   æ´»æ€§ä¿ç•™ {r['_act']}"
    )
print(
    f"\nâš  åŽŸå§‹æŽ’åºçš„ä¼ªå½±å€™é€‰ï¼ˆä»…åœ¨ â‰¤2 ç§å£å¾„ä¸­è¿› top-10ï¼‰ï¼š{artifact if artifact else 'æ— '}"
)

# åŽŸå§‹æŽ’åº top-10 çš„æ´»æ€§
raw_top = [next(x for x in fin if x["mutation"] == m) for m in top["a"]]
print(f"\nåŽŸå§‹ targeting_ratio æŽ’åº top-10 çš„ on-target ç¼–è¾‘çŽ‡ï¼š")
for r in raw_top:
    print(
        f"    {r['mutation']:<20} C388 = {r['_c388']:>5.2f}%   é¶å‘æ¯” = {r['_tr']:.2f}"
        f"{'   â† ä½ŽäºŽæ´»æ€§ä¸‹é™' if r['_c388'] < FLOOR*100 else ''}"
    )
n_below = sum(1 for r in raw_top if r["_c388"] < FLOOR * 100)
print(f"    â†’ å…¶ä¸­ {n_below}/10 ä½ŽäºŽæ´»æ€§ä¸‹é™ {FLOOR*100:.0f}%")

# ===========================================================================
# Part 3 â€”â€” å¯¹æœ€ç»ˆå†³ç­–çš„å½±å“
# ===========================================================================
print("\n" + "=" * 96)
print("Part 3ã€€è¿™æ¬¡åå€šæ˜¯å¦å½±å“äº†æˆ‘ä»¬çš„æœ€ç»ˆå€™é€‰é€‰æ‹©ï¼Ÿ")
print("=" * 96)
import os as _os, re as _re

CANDP = "results/ä¸‹ä¸€æ­¥å®žéªŒçªå˜å€™é€‰è¡¨_61ç»„.csv"
cand = rd(CANDP) if _os.path.exists(CANDP) else []


def canon(s):
    """æŠŠ 30H-58M / G30H+Q58M / 27T-30H-58M ç­‰å†™æ³•ç»Ÿä¸€æˆæ®‹åŸºå·+æ°¨åŸºé…¸çš„æœ‰åºé›†åˆã€‚"""
    toks = _re.findall(r"([A-Z]?)(\d+)([A-Z])", str(s).upper())
    return frozenset(f"{p}{a}" for _, p, a in toks)


cand_sets = {canon(r.get("çªå˜", "")): r for r in cand}

biased_names = {
    m
    for m in top["a"]
    if next(x for x in fin if x["mutation"] == m)["_c388"] < FLOOR * 100
}
hit = sorted(m for m in biased_names if canon(m) in cand_sets)
print(f"  61 æ¡å€™é€‰è¡¨è½½å…¥ï¼š{len(cand)} æ¡")
print(
    f"  åŽŸå§‹æŽ’åº top-10 ä¸­ä½ŽäºŽæ´»æ€§ä¸‹é™çš„æž„å»ºä½“ï¼ˆ{len(biased_names)} ä¸ªï¼‰ï¼š{sorted(biased_names)}"
)
print(f"  å…¶ä¸­è¿›å…¥ 61 æ¡å€™é€‰è¡¨çš„ï¼š{hit if hit else 'æ— '}")

# åå‘æ ¸å¯¹ï¼šç¨³å¥å€™é€‰æœ‰å¤šå°‘è¿›äº†å€™é€‰è¡¨
rob = [m for m in cnt if cnt[m] >= 4]
rob_in = sorted(m for m in rob if canon(m) in cand_sets)
print(f"\n  8 ä¸ªç¨³å¥å€™é€‰ä¸­è¿›å…¥ 61 æ¡å€™é€‰è¡¨çš„ï¼š{rob_in if rob_in else 'æ— '}")
for m in rob:
    r = next(x for x in keep if x["mutation"] == m)
    print(
        f"    {m:<18} {'âœ“ å·²åœ¨å€™é€‰è¡¨' if canon(m) in cand_sets else 'â€” æœªçº³å…¥'}"
        f"   é¶å‘æ¯” {r['_tr']:.2f}  C388 {r['_c388']:.1f}%  æ´»æ€§ {r['_act']}"
    )
print(f"\n  è¯´æ˜Žï¼šå‘½ä¸­è€…ä¸º C18ï¼ˆG25E+K30Hï¼‰ï¼Œä¸Ž 25E-30H æ˜¯åŒä¸€ç»„åˆï¼›")
print(
    f"        ä½†å®ƒåœ¨å€™é€‰è¡¨ä¸­çš„å…¥é€‰ç†ç”±æ˜¯ã€Œå¤éªŒé‡å¤æ€§ + ä½œä¸º Q58M é…å¯¹ï¼ˆC18/C28ï¼‰çš„å¯¹ç…§è‡‚ã€ï¼Œ"
)
print(f"        ä¸Ž targeting_ratio æŽ’åæ— å…³ã€‚")
print(f"\n  â†’ 61 æ¡å€™é€‰è¡¨ä»¥ +1 æ¯”ä¸Žæœºåˆ¶è®ºè¯ä¸ºæŒ‘é€‰ä¾æ®ï¼Œä»Žæœªä½¿ç”¨ targeting_ratio æŽ’åºï¼›")
print(f"     æœ¬æ¬¡åå€šæœªä¼ å¯¼åˆ°æœ€ç»ˆå€™é€‰é€‰æ‹©ã€‚")
print(f"     ä½† 8 ä¸ªç¨³å¥å€™é€‰ä¸­æœ‰ 6 ä¸ªå°šæœªçº³å…¥ä»»ä½•ä¸€è½®å®žéªŒï¼Œå¯ä½œä¸ºè¡¥å……éªŒè¯çš„å‚è€ƒæ¸…å•ã€‚")

# ---------- å†™å‡º ----------
with open(OUT1, "w", newline="", encoding="utf-8-sig") as f:
    w = csv.DictWriter(f, fieldnames=list(res1[0]))
    w.writeheader()
    w.writerows(res1)
print(f"\nå†™å…¥ {OUT1}")

rank_rows = []
for m in sorted(cnt, key=lambda x: -cnt[x]):
    r = next((x for x in keep if x["mutation"] == m), None)
    rank_rows.append(
        dict(
            æž„å»ºä½“=m,
            å‘½ä¸­å£å¾„æ•°=cnt[m],
            åŽŸå§‹é¶å‘æ¯”=round(r["_tr"], 3) if r else "",
            C388_pct=r["_c388"] if r else "",
            æ´»æ€§ä¿ç•™=r["_act"] if r else "",
            æ´»æ€§æ®‹å·®=round(r["_resid"], 3) if r and "_resid" in r else "",
            å¹³å‡éžGCG=round(score(r, "d"), 2) if r and score(r, "d") is not None else "",
            å½’ä¸€åŒ–è„±é¶è´Ÿè·=(
                round(score(r, "e"), 2) if r and score(r, "e") is not None else ""
            ),
            plus1_ratio=r["_p1"] if r else "",
            åˆ¤å®š=("ç¨³å¥å€™é€‰" if cnt[m] >= 4 else ("ä¼ªå½±å€™é€‰" if cnt[m] <= 2 else "ä¸­é—´")),
        )
    )
with open(OUT2, "w", newline="", encoding="utf-8-sig") as f:
    w = csv.DictWriter(f, fieldnames=list(rank_rows[0]))
    w.writeheader()
    w.writerows(rank_rows)
print(f"å†™å…¥ {OUT2}")

endstream
