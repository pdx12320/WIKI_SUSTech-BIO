            act=float(r["activity_retention"]),
            is_wt=r["is_WT"] == "True",
        )
    except ValueError:
        pass


# 1-letter è½¬æ¢ï¼ˆå¹²é¢„æµ‹é”®å T31V ç­‰ï¼›æ¹¿å®žéªŒé”®å 31A ç­‰ï¼‰
def to_wet_key(k):
    m = re.match(r'([A-Z])(\d+)([A-Z])$', k)
    return f"{m.group(2)}{m.group(3)}" if m else k


# ---------- Sheet1ï¼šçªå˜çº§å¯¹ç…§ ----------
rows1 = []
for mut_dry, v_mcsm in mcsm.items():
    wk = to_wet_key(mut_dry)
    if wk not in wet:
        continue
    rows1.append(
        dict(
            dry=mut_dry,
            wet_key=wk,
            resi=wet[wk]["resi"],
            mcsm=v_mcsm,
            prem=prem.get(mut_dry),
            ratio=wet[wk]["ratio"],
            retain=wet[wk]["retain"],
            active=wet[wk]["active"],
        )
    )
# æŽ’åï¼ˆå¹²ï¼šmCSM é™åºï¼›æ¹¿ï¼š+1æ¯” é™åºï¼‰
rows1.sort(key=lambda x: -x["mcsm"])
for i, r in enumerate(rows1, 1):
    r["mcsm_rank"] = i
tmp = sorted(rows1, key=lambda x: -x["ratio"])
for i, r in enumerate(tmp, 1):
    r["wet_rank"] = i
for r in rows1:
    r["rank_diff"] = r["wet_rank"] - r["mcsm_rank"]
    d = r["rank_diff"]
    if d >= 3:
        r["verdict"] = f"âœ— å¹²é«˜ä¼°ï¼ˆå¹²ç¬¬{r['mcsm_rank']}â†’æ¹¿ç¬¬{r['wet_rank']}ï¼‰"
    elif d <= -3:
        r["verdict"] = f"â†‘ å¹²ä½Žä¼°ï¼ˆå¹²ç¬¬{r['mcsm_rank']}â†’æ¹¿ç¬¬{r['wet_rank']}ï¼‰"
    else:
        r["verdict"] = f"â—‹ å¤§è‡´ä¸€è‡´ï¼ˆå·® {abs(d)} åï¼‰"

