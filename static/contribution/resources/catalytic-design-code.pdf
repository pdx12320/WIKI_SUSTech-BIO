    1,
    "Î”Î”CP = Î”CP(çªå˜ä½“) âˆ’ Î”CP(WT)ï¼›çº¢ â‰¥ +0.15ï¼ˆåè„±é¶ï¼‰ï¼Œè“ â‰¤ âˆ’0.10ï¼ˆå on-targetï¼‰",
).font = Font(italic=True, size=9)

# --- Sheet3 é•¿æ ¼å¼ ---
ws3 = wb.create_sheet("3_é•¿æ ¼å¼æ˜Žç»†")
ws3.append(
    [
        "çªå˜ä½“",
        "æ®‹åŸº",
        "WT_aa",
